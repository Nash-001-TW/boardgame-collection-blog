---
export const prerender = false;

const { searchParams } = Astro.url;
const collection = searchParams.get('collection');
const lang = searchParams.get('lang');
const params = new URLSearchParams();
let path = '/admin/sleeves';

if (collection !== null && /^[1-9][0-9]*$/.test(collection) && Number.isSafeInteger(Number(collection))) {
    path = '/admin/collection/' + collection + '/sleeves';
    params.set('scope', searchParams.get('scope') ?? 'production');
}
if (lang !== null) params.set('lang', lang);

return Astro.redirect(path + (params.size ? '?' + params : ''), 302);
---
