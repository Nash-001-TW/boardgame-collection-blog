---
import Layout from "../../../layouts/Layout.astro";
import GameDetail from "../../../components/GameDetail.astro";
import { translateGameName } from "../../../i18n/utils";

import {
    getGameDetails
} from "../../../lib/games";

import type {
    GameDetailModel
} from "../../../lib/games";


export function getStaticPaths() {

    const games =
        getGameDetails();

    return games.map(
        game => ({

            params: {
                slug: game.slug
            },

            props: {
                game
            }

        })
    );
}


interface Props {
    game: GameDetailModel;
}


const {
    game
} = Astro.props;
---

<Layout
    catalogPage
    detailPage
    title={`${translateGameName(game.bggId, game.bgg.name, "en")} | Soma's Board Game Collection`}
    lang="en"
>

    <GameDetail
        game={game}
        lang="en"
    />

</Layout>
