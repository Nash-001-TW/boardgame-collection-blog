---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import GameList from "../../components/GameList.astro";

import { getGames } from "../../lib/games";

export const prerender = false;
import { loadPublicCatalog } from "../../lib/notbgg-public";
const games = getGames();
const {payload,notBggAvailable}=await loadPublicCatalog(games,env.DB,"en");
Astro.response.headers.set('Cache-Control','no-store');
---

<Layout
    catalogPage
    title="Game Database | Soma's Board Game Collection Blog"
    lang="en"
>
    <h1>Game Database</h1>

    <p class="intro">
        Browse all registered and imported games, whether collected or not.
    </p>

    {!notBggAvailable&&<p role="status">{"NotBGG is temporarily unavailable. Showing the BGG catalog only."}</p>}
    <GameList payload={payload} live
        games={games}
        lang="en"
    />

</Layout>

<style>
    .intro {
        color: #666;
        margin-bottom: 30px;
    }
</style>
