---
import Layout from "../layouts/Layout.astro";
import GameList from "../components/GameList.astro";

import { getGames } from "../lib/games";

const games = getGames();
---

<Layout
    title="桌遊庫 | Soma's Board Game Collection Blog"
    lang="zh-TW"
>
    <h1>🎲 桌遊庫</h1>

    <p class="intro">
        這裡整理我玩過、收藏以及介紹過的桌遊。
    </p>

    <GameList
        games={games}
        lang="zh-TW"
    />

</Layout>

<style>
    .intro {
        color: #666;
        margin-bottom: 30px;
    }
</style>