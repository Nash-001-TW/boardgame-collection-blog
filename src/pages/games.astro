---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import GameList from "../components/GameList.astro";

import { getGames } from "../lib/games";

export const prerender = false;
import { loadPublicCatalog } from "../lib/notbgg-public";
const games = getGames();
const {payload,notBggAvailable}=await loadPublicCatalog(games,env.DB,"zh-TW");
Astro.response.headers.set('Cache-Control','no-store');
---

<Layout
    catalogPage
    title="遊戲資料庫 | Soma's Board Game Collection Blog"
    lang="zh-TW"
>
    <h1>遊戲資料庫</h1>

    <p class="intro">
        瀏覽所有已建立或匯入的桌遊，不限是否收藏。
    </p>

    {!notBggAvailable&&<p role="status">{"NotBGG 暫時無法載入；目前僅顯示 BGG 目錄。"}</p>}
    <GameList payload={payload} live
        games={games}
        lang="zh-TW"
    />

</Layout>

<style>
    .intro {
        color: #666;
        margin-bottom: 30px;
    }
</style>
