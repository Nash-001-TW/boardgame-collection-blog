---
interface Props { gameKey:string;lang:'zh-TW'|'en' }
const {gameKey,lang}=Astro.props,en=lang==='en';
---
<div class="public-game-collection" data-public-game-collection data-game-key={gameKey} data-lang={lang}>
    <section class="public-data-panel" id="game-collection">
        <h2>{en?'My collection':'收藏資訊'}</h2>
        <div data-public-collection-body aria-live="polite"><p>{en?'Loading collection records…':'正在載入收藏資料…'}</p></div>
    </section>
    <section class="public-data-panel" id="game-sleeves">
        <h2>{en?'Sleeve requirements':'卡套需求'}</h2>
        <div data-public-requirements-body aria-live="polite"><p>{en?'Loading managed sleeve requirements…':'正在載入已管理的卡套需求…'}</p></div>
    </section>
    <p data-public-data-error role="alert" hidden></p>
    <button type="button" data-public-data-retry hidden>{en?'Retry collection and requirements':'重新載入收藏與需求'}</button>
    <noscript>{en?'JavaScript is required to load current collection and sleeve data.':'即時收藏與卡套資料需要 JavaScript 載入。'}</noscript>
</div>
<script>import '../lib/public-game-collection-controller';</script>
<style>
.public-game-collection{display:grid;gap:18px;min-width:0}.public-data-panel{min-width:0;background:#fff;border:1px solid #e3e4e4;border-radius:14px;padding:22px;box-shadow:0 2px 8px #253d4c03;scroll-margin-top:20px}.public-game-collection h2{font-size:1.1rem;margin:0 0 14px}
.public-game-collection :global(p){font-size:.85rem;line-height:1.7;overflow-wrap:anywhere}
.public-game-collection :global(article){padding:14px 0;border-top:1px solid #e5e9ee;min-width:0}
.public-game-collection :global(h3){font-size:.95rem;line-height:1.5;margin:0 0 8px;overflow-wrap:anywhere}
.public-game-collection :global(ul){font-size:.84rem;padding-left:20px;line-height:1.75;overflow-wrap:anywhere}
.public-game-collection :global(.public-status){display:inline-block;padding:3px 8px;margin:0 6px 5px 0;border-radius:5px;background:#eaf1f6;font-size:.78rem;overflow-wrap:anywhere}
.public-game-collection :global(.public-data-note){color:#657180;font-size:.8rem}
.public-game-collection :global(details){margin-top:10px;font-size:.82rem}
.public-game-collection :global(summary){cursor:pointer;color:#244e73;padding:6px 0}
.public-game-collection [role=alert]{padding:14px;background:#fff0ed;border:1px solid #e8bab3;border-radius:8px;color:#8d251c}
.public-game-collection button{justify-self:start;min-height:44px;border:1px solid #ccd5de;border-radius:8px;background:#fff;padding:10px 14px;color:#244e73;cursor:pointer;font:inherit}
.public-game-collection button:focus-visible,.public-game-collection :global(summary:focus-visible){outline:3px solid #427ba5;outline-offset:3px}
@media(max-width:680px){.public-data-panel{padding:17px}.public-game-collection{gap:14px}}
</style>
