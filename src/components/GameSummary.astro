---
import { getGames } from "../lib/games";
import type { Language } from "../i18n/ui";

interface Props {
    lang: Language;
}

const { lang } = Astro.props;
const games = getGames();
const zh = lang === "zh-TW";

const statistics = [
    {
        label: zh ? "已收藏" : "Owned",
        count: games.filter(g => g.collection.owned).length
    },
    {
        label: zh ? "願望清單" : "Wishlist",
        count: games.filter(g => g.collection.wishlist).length
    },
    {
        label: zh ? "預購" : "Preordered",
        count: games.filter(
            g => g.collection.willingness === "Preordered"
        ).length
    }
];
---

<div class="game-summary">
    {statistics.map(item => (
        <div class="summary-item">
            <span>{item.label}</span>
            <strong>{item.count}</strong>
        </div>
    ))}
</div>

<style>
    .game-summary {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 12px 0;
        width: 100%;
        min-width: 0;
    }

    .summary-item {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: 12px;

        padding: 10px 12px;
        background: #fffdf8;
        border: 1px solid #e7d7bf;
        border-radius: 10px;
    }

    .summary-item span {
        font-size: 14px;
        font-weight: 500;
        color: #594535;
        white-space: nowrap;
    }

    .summary-item span::after {
        content: "：";
    }

    .summary-item strong {
        font-size: 17px;
        font-weight: 700;
        color: #286b9b;
        font-variant-numeric: tabular-nums;
    }

    @media (max-width: 600px) {
        .summary-item {
            padding: 9px 12px;
        }

        .summary-item strong {
            font-size: 16px;
        }
    }
</style>