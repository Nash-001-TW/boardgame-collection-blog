---
import {gameRelationTypes,collectionRelationTypes} from '../../lib/relation-admin';
import {relationTypeLabel, relationChoiceLabel} from '../../lib/relation-labels';
import type {readRelationAdmin} from '../../lib/relation-admin';
interface Props{data:Awaited<ReturnType<typeof readRelationAdmin>>;row?:Record<string,unknown>;source?:number;target?:number;lang:'en'|'zh-TW'}
const{data,row,source=0,target=0,lang}=Astro.props,t=(zh:string,en:string)=>lang==='en'?en:zh,game=data.domain==='game';
const choices=game?data.identities:data.collections;
const types=game?gameRelationTypes:collectionRelationTypes;

---
<form data-bgg-action="relation" data-new-collection-relation={!row&&!game ? true : undefined} class="fields">
 <input name="domain" type="hidden" value={data.domain}/><input name="id" type="hidden" value={String(row?.id??0)}/><input name="revision" type="hidden" value={String(row?.admin_revision??0)}/>
 {(['sourceId','targetId']as const).map((name,index)=><label>{index?t('目標','Target'):t('來源','Source')}<select name={name} required>{!row&&!game&&<option value="">{t("請選擇","Select…")}</option>}{choices.map(c=><option value={String(c.id)} data-item-type={!row&&!game ? String(c.item_type) : undefined} selected={c.id===(row?.[game?(index?'target_game_id':'source_game_id'):(index?'target_item_id':'source_item_id')]??(index?target:source))}>{relationChoiceLabel(c,game,lang)}</option>)}</select></label>)}
 <label>{t('關聯類型','Relation type')}<select name="type">{types.map(type=><option value={type} selected={type===(row?.relation_type??'other')}>{relationTypeLabel(type,lang)}</option>)}</select></label>
 {game&&<label><input name="confirmed" type="checkbox" checked={row?.admin_confirmed===1}/>{t('確認此手動關聯（公開頁才會顯示）','Confirm this manual relation for public display')}</label>}
 <label>{t('私人關聯備註','Private relation notes')}<textarea name="notes" maxlength="3000">{String(row?.notes??'')}</textarea></label>
 <button class="admin-button">{t('儲存關聯','Save relation')}</button>
</form>
