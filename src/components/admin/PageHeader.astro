---
import AdminIcon from './AdminIcon.astro';
type Icon = Parameters<typeof AdminIcon>[0]['name'];
interface Props { title: string; description: string; icon: Icon }
const { title, description, icon } = Astro.props;
---
<header class="admin-kit-header">
  <div class="admin-kit-row"><AdminIcon name={icon} size={32} />
    <div><h1>{title}</h1><p>{description}</p></div>
  </div>
  <div class="admin-kit-row"><slot /></div>
</header>
