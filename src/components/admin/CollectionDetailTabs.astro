---
import AdminIcon from './AdminIcon.astro';
interface Props {
  id: string;
  scope: string;
  lang: 'zh-TW' | 'en';
  active: 'details' | 'copies' | 'components' | 'sleeves' | 'purchases';
}
const {id, scope, lang, active} = Astro.props;
const t = (zh: string, en: string) => lang === 'en' ? en : zh;
const base = '/admin/collection/' + encodeURIComponent(id);
const params = new URLSearchParams({scope, lang});
const links = [
  ['details', base + '?' + params, 'list', t('基本資料','Basic details'), t('基本','Details')],
  ['copies', base + '/copies?' + params, 'box', t('副本與品況','Copies & condition'), t('副本','Copies')],
  ['components', base + '/components?' + params, 'puzzle', t('實體組件','Physical components'), t('組件','Parts')],
  ['sleeves', base + '/sleeves?' + params, 'sleeves', t('卡套需求','Sleeve requirements'), t('卡套','Sleeves')],
  ['purchases', base + '/purchases?' + params, 'cart', t('相關採購','Related purchases'), t('採購','Orders')],
] as const;
---
<nav aria-label={t('收藏詳細頁分頁','Collection detail pages')} class="admin-detail-tabs" data-detail-tabs>
  {links.map(([key, href, icon, label, compactLabel]) => (
    <a class="admin-kit-button" data-variant={active === key ? 'primary' : 'secondary'} href={href}
      aria-label={label} aria-current={active === key ? 'page' : undefined}>
      <AdminIcon name={icon} size={18} />
      <span class="admin-detail-tab-label">{label}</span>
      <span class="admin-detail-tab-compact" aria-hidden="true">{compactLabel}</span>
    </a>
  ))}
</nav>
