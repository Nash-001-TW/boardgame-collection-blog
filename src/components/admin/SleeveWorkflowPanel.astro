---
import { env } from 'cloudflare:workers';
import { HttpError } from '../../lib/notbgg-admin-api';
import { readSleeveWorkflow } from '../../lib/sleeve-workflow';
import { readSleeveShortage, type ShortageStatus } from '../../lib/sleeve-shortage';
import SleeveRequirementForm from './SleeveRequirementForm.astro';
interface Props { collectionId: number; lang: 'zh-TW' | 'en'; }
const { collectionId, lang } = Astro.props;
const en=lang==='en',t=(zh:string,english:string)=>en?english:zh;
let data:Awaited<ReturnType<typeof readSleeveWorkflow>>|undefined,error='';
let archived = false;
if (collectionId) try {
    data = await readSleeveWorkflow(env.DB,collectionId,(env as unknown as Record<string,unknown>).PHYSICAL_COMPONENT_SIGNING_KEY);
} catch (cause) {
    // The route has already checked that this collection exists in the requested scope.
    if (cause instanceof HttpError && cause.status === 404 && cause.code === 'COLLECTION_UNAVAILABLE') {
        archived = true;
    } else {
        Astro.response.status=503;error=t('無法載入收藏卡套資料。','Collection sleeve data could not be loaded.');
    }
}
const shortageStatuses = new Map<number, ShortageStatus>();
let shortageUnavailable = false;
if (data?.requirements.length && Astro.url.searchParams.get('scope') !== 'test') {
    try {
        for (const row of (await readSleeveShortage(env.DB)).rows) shortageStatuses.set(row.id, row.status);
    } catch (cause) {
        console.error('Collection sleeve shortage read failed', cause instanceof Error ? cause.name : typeof cause);
        shortageUnavailable = true;
    }
}
const shortageMessages = {
    shortage: t('此尺寸與其他收藏合計的需求超過庫存', 'Combined demand for this size across collections exceeds stock'),
    incomplete: t('此尺寸資料不完整，無法判定庫存是否足夠', 'Data for this size is incomplete, so stock sufficiency is unknown'),
    no_product: t('尚無此尺寸的卡套產品', 'No sleeve products for this size'),
    sufficient: '',
    none: '',
};
---
<section class="admin-sleeve-workflow" aria-label={t('卡套需求與逐副本套用','Sleeve requirements & copy applications')} data-sleeve-workflow data-lang={lang}>
 <p role="status" tabindex="-1" data-workflow-status aria-live="polite"></p>
 {error&&<p role="alert">{error}</p>}
 {archived&&<p>{t('此收藏已封存，卡套需求僅供保留，不提供操作。','This collection is archived; sleeve requirements are kept for reference and cannot be changed.')}</p>}
 {data&&<>
  <h2>{String(data.collection.display_name)} · #{collectionId}</h2>
  <p>{t('建立需求與關聯不扣庫存。套用需要已確認卡牌及已清點的在藏、未封膜副本。已有套用的需求鎖定；變更需求請新增另一筆。','Requirements and assignments do not reduce stock. Applying needs confirmed cards and an inspected, unsealed copy in collection. Used requirements are locked; add another requirement for changes.')}</p>
  <details class="workflow-panel"><summary>{t('新增卡套需求','Add sleeve requirement')}</summary><SleeveRequirementForm data={data} collectionId={collectionId} lang={lang}/></details>
  <label>{t('需求篩選','Requirement filter')}<select data-assignment-filter><option value="all">{t('全部','All')}</option><option value="unassigned">{t('未指派','Unassigned')}</option><option value="assigned">{t('已關聯','Assigned')}</option></select></label>
  {shortageUnavailable && <p role="status">{t('無法取得尺寸庫存狀況。', 'Size stock status is unavailable.')}</p>}
  {data.requirements.length===0&&<p>{t('尚無卡套需求。','No sleeve requirements.')}</p>}
  {data.requirements.map(r=>{
   const status = shortageStatuses.get(Number(r.size_id)) ?? 'none';
   const applications=data!.applications.filter(a=>a.requirement_id===r.id);
   const locked=applications.length>0||data!.applications.some(a=>a.requirement_id===null);
   const eligible=data!.eligible.includes(Number(r.component_definition_id));
   // Show which card component the requirement belongs to, so assigned and unassigned rows are distinguishable at a glance.
   const component=r.component_definition_id===null?undefined:data!.components.find(c=>Number(c.id)===Number(r.component_definition_id));
   const componentName=r.component_definition_id===null?t('未指派組件','No component assigned'):String(component?.component_name??t('組件 #','Component #')+String(r.component_definition_id));
   return <article class="workflow-panel" data-requirement={String(r.id)} data-assigned={r.component_definition_id===null?'unassigned':'assigned'}>
    <h3>#{String(r.id)} · <span data-requirement-component>{componentName}</span> · {Number(r.width_tenth_mm)/10} × {Number(r.height_tenth_mm)/10} mm · {String(r.quantity_sheets)} {t('張','sleeves')}</h3>
    {shortageMessages[status] && <p data-sleeve-shortage={status}>{shortageMessages[status]}</p>}
    <p>{r.component_definition_id===null?t('未指派','Unassigned'):'#'+String(r.component_definition_id)+' '+String(component?.component_name??'')+' · '+(eligible?t('已確認實體卡牌','Confirmed physical card'):t('歷史／待確認引用（不可套用）','Legacy / unverified reference (cannot apply)'))}</p>
    {r.notes&&<p data-requirement-notes>{t('說明：','Notes: ')}{String(r.notes)}</p>}
    {locked?<p>{t('已有套用紀錄，需求已鎖定。','Requirement locked by recorded applications.')}</p>:<details><summary>{t('編輯需求','Edit requirement')}</summary><SleeveRequirementForm data={data!} row={r} collectionId={collectionId} lang={lang}/></details>}
    {data!.copies.filter(c=>r.owned_copy_id===null||r.owned_copy_id===c.id).map(c=>{
     const rows=applications.filter(a=>a.owned_copy_id===c.id),used=rows.reduce((sum,a)=>sum+Number(a.quantity_sheets),0);
     const legacy=data!.applications.some(a=>a.owned_copy_id===c.id&&a.requirement_id===null);
     const inspected=data!.counts.some(cc=>cc.owned_copy_id===c.id&&cc.component_definition_id===r.component_definition_id);
     const canApply=!legacy&&eligible&&inspected&&c.inventory_status==='in_collection'&&c.seal_status!=='sealed'&&used<Number(r.quantity_sheets);
     return <section class="copy-application" data-copy={String(c.id)}>
      <h4>{t('副本','Copy')} #{String(c.id)} {String(c.copy_label??'')}</h4>
      <p>{legacy?t('存在未對應需求的歷史套用，以下進度僅計算已對應紀錄。','Unmapped historical applications exist; progress below includes mapped records only.'):''}</p>
      <p>{used} / {String(r.quantity_sheets)} · {legacy?t('進度無法判定（歷史套用未對應）','Progress unavailable (unmapped historical use)'):used===0&&Number(r.quantity_sheets)>0?t('尚未套用','Not applied'):used<Number(r.quantity_sheets)?t('部分套用','Partially applied'):t('已完成','Complete')}</p>
      <ul>{rows.map(a=><li>{String(a.brand??'')} {String(a.product_name)} · {String(a.quantity_sheets)} · {String(a.applied_at)}</li>)}</ul>
      {canApply&&<form data-workflow-action="apply" class="fields">
       <input type="hidden" name="id" value={String(r.id)}/><input type="hidden" name="revision" value={String(r.assignment_revision)}/><input type="hidden" name="copyId" value={String(c.id)}/>
       <input type="hidden" name="lastApplicationId" value={String(rows.length?rows[rows.length-1].id:0)}/>
       <label>{t('實際使用產品','Actual product')}<select name="productId" required>{data!.products.filter(p=>p.size_id===r.size_id).map(p=><option value={String(p.id)} data-revision={String(p.admin_revision)} data-last={String(p.last_transaction_id)}>{String(p.brand??'')} {String(p.product_name)} · {t('帳面餘額','Ledger balance')}: {p.balance===null?t('尚未建立','Not established'):String(p.balance)}</option>)}</select></label>
       <label>{t('本次實際套用張數','Sleeves applied now')}<input name="quantity" required type="number" min="1" max={Number(r.quantity_sheets)-used} step="1"/></label>
       <label>{t('套用日期','Application date')}<input name="date" type="date" required/></label>
       <label><input name="notPreviouslyRecorded" type="checkbox" required/>{t('確認本次使用尚未透過手動庫存交易記錄；不可用此功能補登已扣帳歷史。','This use has not already been recorded in the stock ledger. Do not re-enter previously deducted history.')}</label>
       <button class="admin-button primary">{t('確認套用並扣庫存','Apply and deduct stock')}</button>
      </form>}
     </section>;
    })}
   </article>;
  })}
  {data.applications.some(a=>a.requirement_id===null)&&<section class="workflow-panel"><h3>{t('未對應需求的歷史套用（不重扣庫存）','Historical applications without requirement mapping (no additional deduction)')}</h3><ul>{data.applications.filter(a=>a.requirement_id===null).map(a=><li>#{String(a.id)} · {t('副本','Copy')} #{String(a.owned_copy_id)} · {String(a.product_name)} · {String(a.quantity_sheets)}</li>)}</ul></section>}
 </>}
</section>
<script>import '../../lib/sleeve-workflow-controller';</script>
<style>.workflow-panel{border:1px solid var(--admin-border);background:var(--admin-surface);padding:20px;border-radius:10px;margin:20px 0;min-width:0;overflow-wrap:anywhere}.copy-application{border-top:1px solid var(--admin-border);margin-top:20px;padding-top:10px}.workflow-panel summary{cursor:pointer;padding:10px 0}.workflow-panel li{overflow-wrap:anywhere}</style>
