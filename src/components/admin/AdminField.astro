---
interface Props {
  field: { key: string; label: readonly string[]; kind: string; max: number; min?: number; required?: boolean };
  lang: 'zh-TW' | 'en';
}
const { field, lang } = Astro.props, en = lang === 'en';
const multiline = ['list', 'textarea', 'refs'].includes(field.kind);
const help = field.kind === 'refs' ? (en ? 'One registered BGG:ID or NotBGG:ID per line.' : '每行填寫一個已登記的 BGG:ID 或 NotBGG:ID。')
  : field.kind === 'counts' ? (en ? 'Separate with commas or spaces; use the known player range.' : '以逗號或空白分隔，需落在已知玩家人數範圍內。')
  : field.kind === 'textarea' ? (en ? `Maximum ${field.max.toLocaleString()} characters.` : `最多 ${field.max.toLocaleString()} 字元。`)
  : field.required ? (en ? 'Required. Maximum 300 characters.' : '必填，最多 300 字元。') : '';
---
<div class:list={['admin-field', { 'field-wide': multiline || field.kind === 'counts' || field.key === 'name' }]}>
  <label for={field.key}>{field.label[en ? 1 : 0]}</label>
  {multiline ? <textarea id={field.key} name={field.key} rows={field.kind === 'textarea' ? 4 : 2} maxlength={field.max} aria-describedby={`help-${field.key} error-${field.key}`} />
    : <input id={field.key} name={field.key} type={field.kind === 'number' ? 'number' : field.kind === 'url' ? 'url' : 'text'} required={field.required} min={field.min} max={field.kind === 'number' ? field.max : undefined} maxlength={field.kind !== 'number' ? field.max : undefined} step={field.kind === 'number' ? '1' : undefined} aria-describedby={`help-${field.key} error-${field.key}`} />}
  <small id={`help-${field.key}`} class="field-help">{help}</small>
  <span id={`error-${field.key}`} class="error" data-error={field.key}></span>
  {field.kind === 'url' && <div class="image-preview" data-image-preview={field.key}>
    <div class="preview-toolbar"><span>{en ? 'Image preview' : '圖片預覽'}</span><button type="button" class="preview-refresh" data-preview-refresh>{en ? 'Refresh preview' : '更新預覽'}</button></div>
    <div class="preview-frame" data-preview-frame></div>
    <small class="field-help" data-preview-status role="status" aria-live="polite">{en ? 'No image URL provided.' : '尚未提供圖片網址。'}</small>
  </div>}
</div>
