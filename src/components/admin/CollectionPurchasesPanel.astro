---
import { env } from 'cloudflare:workers';
import { readPurchases } from '../../lib/purchase-admin';
import { readCollectionSleeveGifts } from '../../lib/sleeve-admin';
import { readSeriesSpending } from '../../lib/series-spending';
import AlertBanner from './AlertBanner.astro';
import EmptyState from './EmptyState.astro';

interface Props { collectionId: number; lang: 'zh-TW' | 'en'; }
const { collectionId, lang } = Astro.props;
const t = (zh: string, en: string) => lang === 'en' ? en : zh;
const { pathname, searchParams } = Astro.url;
const collection = String(collectionId);
const params = new URLSearchParams({ collection });
const after = searchParams.get('after');
if (after !== null) params.set('after', after);
let data: Awaited<ReturnType<typeof readPurchases>> | undefined;
try {
    data = await readPurchases(env.DB, params);
} catch {
    Astro.response.status = 503;
}
const costs = data?.costs.filter(row => Number(row.collection_item_id) === collectionId) ?? [];
const statuses = new Map([
    ['open', t('未付款／待處理', 'Open / pending')],
    ['paid', t('已付款', 'Paid')],
    ['partially_received', t('部分收貨', 'Partially received')],
    ['completed', t('完成', 'Completed')],
    ['cancelled', t('取消', 'Cancelled')],
]);
const pageLink = (cursor?: number) => {
    const query = new URLSearchParams({ scope: searchParams.get('scope') ?? 'production', lang });
    if (cursor !== undefined) query.set('after', String(cursor));
    return pathname + '?' + query;
};
const purchaseLink = (query: Record<string, string>) => '/admin/purchases?' + new URLSearchParams({...query, lang});
const createLink = purchaseLink({ new: '1', collection });
const createLabel = t('新增採購（預填此收藏）', 'New purchase (prefill this collection)');
const unavailable = t('無法取得', 'Unavailable');
let gifts: Awaited<ReturnType<typeof readCollectionSleeveGifts>> | undefined;
try {
    gifts = await readCollectionSleeveGifts(env.DB, collectionId);
} catch (error) {
    console.error('Collection sleeve gifts unavailable', error);
}
let series: Awaited<ReturnType<typeof readSeriesSpending>> | undefined;
try {
    series = await readSeriesSpending(env.DB, collectionId);
} catch (error) {
    console.error('Collection series spending unavailable', error);
}
const seriesMemberLink = (id: number) => `/admin/collection/${id}/purchases?lang=${lang}`;
const seriesRelationsLink = (id: number) => '/admin/bgg?' + new URLSearchParams({
    view: 'relations', domain: 'collection', source: String(id), lang,
});
const relationLabels = new Map([
    ['expansion_of', t('擴充', 'Expansion')], ['requires_base', t('需要本體', 'Requires base game')],
    ['accessory_for', t('專用', 'Dedicated')], ['compatible_with', t('相容', 'Compatible')],
    ['same_series', t('同系列', 'Same series')], ['standalone_related', t('獨立相關', 'Related standalone')],
    ['integrates_with', t('可整合', 'Integrates with')],
]);
const missingCost = t('尚未記錄成本', 'No recorded costs');
const manageSeries = t('管理收藏組合關係', 'Manage collection relationships');
---
<section class="admin-collection-purchases" aria-label={t('相關採購', 'Related purchases')}>
    <div class="admin-collection-purchase-links">
        <a class="admin-kit-button" data-variant="primary" href={createLink}>{createLabel}</a>
        <a class="admin-kit-button" href={purchaseLink({ collection })}>{t('在採購管理開啟', 'Open in purchase management')}</a>
    </div>
    {data ? <>
        <section class="admin-kit-panel">
            <h2>{t('此收藏的已記錄成本', 'Recorded costs for this collection')}</h2>
            <p>{t('只計採購分攤，不含歷史價格與維修費。金額依幣別以整數最小貨幣單位顯示。', 'Includes purchase allocations only, excluding historical prices and repair costs. Amounts are shown in integer minor units by currency.')}</p>
            {costs.length ? <ul>
                {costs.map(row => <li>{String(row.currency_code)} · {String(row.allocated_minor)}</li>)}
            </ul> : <p>{t('尚無已記錄成本。', 'No recorded costs yet.')}</p>}
        </section>
    </> : null}
    <section class="admin-kit-panel" data-series-spending>
        <h2>{t('系列花費合計', 'Series spending')}</h2>
        {series === undefined ? <AlertBanner tone="danger" title={unavailable} unavailableLabel={unavailable}
            description={t('無法取得系列花費。', 'Series spending could not be loaded.')}
            href={pathname + Astro.url.search} linkLabel={t('重試', 'Retry')} />
        : series.status === 'inapplicable' ? <p>{t('不適用（只計正式收藏）', 'Not applicable (production collections only)')}</p>
        : series.status === 'ambiguous' ? <>
            <p>{t('此收藏關聯到多個本體。', 'This collection is linked to multiple base games.')}</p>
            <ul>{series.candidates.map(candidate => <li><a href={seriesMemberLink(candidate.id)}>{candidate.display_name}</a></li>)}</ul>
            <p><a href={seriesRelationsLink(collectionId)}>{manageSeries}</a></p>
        </> : <>
            <p>{t(
                '只計已付款、部分收貨與完成訂單的採購分攤。金額依幣別列出最小貨幣單位，無匯率換算。合計排除維修等其他費用、卡套金額與另列的共用禮包。',
                'Includes purchase allocations from paid, partially received and completed orders. Amounts are in minor units by currency, with no conversion. Repairs, sleeve costs and separately listed shared bundles are excluded.',
            )}</p>
            <h3>{t('成員', 'Members')}</h3>
            <table class="admin-series-table" role="table" aria-label={t('系列成員', 'Series members')}>
                <thead role="rowgroup"><tr role="row">
                    <th role="columnheader" scope="col">{t('名稱', 'Name')}</th>
                    <th role="columnheader" scope="col">{t('關係', 'Relationship')}</th>
                    <th role="columnheader" scope="col">{t('已記錄成本', 'Recorded costs')}</th>
                </tr></thead>
                <tbody role="rowgroup">{series.members.map(member => <tr role="row">
                    <th role="rowheader" scope="row"><a href={seriesMemberLink(member.id)}>{member.display_name}</a>
                        {member.id === collectionId && <> · {t('目前', 'Current')}</>}
                    </th>
                    <td role="cell">{member.relation_type === null ? t('本體', 'Base game') : relationLabels.get(member.relation_type)}</td>
                    <td role="cell">{member.costs.length ? member.costs.map(cost => <div>{cost.currency_code} · {cost.allocated_minor}</div>) : missingCost}</td>
                </tr>)}</tbody>
            </table>
            {series.truncated && <p>{series.accessories.length
                ? t('系列成員與相關配件共顯示並計算最多 100 款，含目前收藏。', 'Showing and totaling up to 100 members and accessories combined, including the current collection.')
                : t('最多顯示並計算 100 款成員，含目前收藏。', 'Showing and totaling up to 100 members, including the current collection.')}</p>}
            <h3>{t('合計', 'Total')}</h3>
            {series.totals.length ? <ul>{series.totals.map(cost => <li>{cost.currency_code} · {cost.allocated_minor}</li>)}</ul> : <p>{missingCost}</p>}
            <p>{t(`其中 ${series.missing} 款尚未記錄成本`, `${series.missing} members without recorded costs`)}</p>
            {series.accessories.length > 0 && <section data-series-accessories>
                <h3>{t('相關配件', 'Related accessories')}</h3>
                <table class="admin-series-table" role="table" aria-label={t('相關配件', 'Related accessories')}>
                    <thead role="rowgroup"><tr role="row">
                        <th role="columnheader" scope="col">{t('名稱', 'Name')}</th>
                        <th role="columnheader" scope="col">{t('關係', 'Relationship')}</th>
                        <th role="columnheader" scope="col">{t('已記錄成本', 'Recorded costs')}</th>
                    </tr></thead>
                    <tbody role="rowgroup">{series.accessories.map(accessory => <tr role="row">
                        <th role="rowheader" scope="row"><a href={seriesMemberLink(accessory.id)}>{accessory.display_name}</a>
                            {accessory.id === collectionId && <> · {t('目前收藏', 'Current collection')}</>}
                        </th>
                        <td role="cell">{relationLabels.get(accessory.relation_type)}</td>
                        <td role="cell">{accessory.costs.length ? accessory.costs.map(cost => <div>{cost.currency_code} · {cost.allocated_minor}</div>) : missingCost}</td>
                    </tr>)}</tbody>
                </table>
                <h4>{t('配件小計（不併入系列合計）', 'Accessory subtotal (excluded from series total)')}</h4>
                {series.accessoryTotals.length ? <ul>{series.accessoryTotals.map(cost => <li>{cost.currency_code} · {cost.allocated_minor}</li>)}</ul> : <p>{missingCost}</p>}
                <p>{t(`其中 ${series.accessoryMissing} 款配件尚未記錄成本`,
                    series.accessoryMissing === 1 ? '1 accessory without recorded costs' : `${series.accessoryMissing} accessories without recorded costs`)}</p>
            </section>}
            {series.members.length === 1 && series.accessories.length === 0 && <p>{t('尚未建立系列關聯。可到', 'No series relationships yet. Open ')}
                <a href={seriesRelationsLink(series.baseId)}>{manageSeries}</a>{t('新增擴充、配件或同系列關聯。', ' to add expansions, accessories or games in the same series.')}
            </p>}
            {series.bundles.length > 0 && <div data-series-shared-bundles>
                <h3>{t('共用禮包', 'Shared bundles')}</h3>
                <ul class="admin-series-bundles">{series.bundles.map(bundle => <li>
                    <div><a href={seriesMemberLink(bundle.id)}>{bundle.display_name}</a></div>
                    <div>{t(`共 ${bundle.included} 款，其中 ${bundle.in_series} 款在此系列`, `${bundle.included} included, ${bundle.in_series} in this series`)}</div>
                    <div>{bundle.costs.length ? bundle.costs.map(cost => <div>{cost.currency_code} · {cost.allocated_minor}</div>) : missingCost}</div>
                </li>)}</ul>
            </div>}
            <p>{t(`卡套 · 已套用 ${series.applied} 張 · 附贈 ${series.gifts} 張`, `Sleeves · ${series.applied} applied · ${series.gifts} complimentary`)}</p>
        </>}
    </section>
    {data ? <>
        <section class="admin-kit-panel">
            <h2>{t('相關訂單', 'Related orders')}</h2>
            {data.orders.length ? <>
                <p>{t('以下為整筆訂單金額，以整數最小貨幣單位顯示。', 'Amounts below are for whole orders, in integer minor units.')}</p>
                <ul class="admin-collection-purchase-orders">
                    {data.orders.map(row => <li>
                        <h3><a href={purchaseLink({ id: String(row.id) })}>#{String(row.id)}{row.order_reference ? ' · ' + String(row.order_reference) : ''}</a></h3>
                        <p>{String(row.ordered_at ?? '—')} · {String(row.merchant_name ?? '—')} · {String(row.currency_code)} · {statuses.get(String(row.status)) ?? String(row.status)}</p>
                        <p>{t('淨額／已分攤／未分攤', 'Net / allocated / unallocated')} · {String(row.paid_minor)} / {String(row.allocated_minor)} / {String(row.unallocated_minor)}</p>
                    </li>)}
                </ul>
            </> : <EmptyState illustration="/images/admin/empty-no-result.webp"
                reason={t('沒有符合條件的採購。', 'No matching purchases.')} href={createLink} action={createLabel} />}
            <nav class="admin-collection-purchase-links" aria-label={t('相關訂單分頁', 'Related order pages')}>
                <a class="admin-kit-button" href={pageLink()}>{t('第一頁', 'First page')}</a>
                {data.nextCursor !== null && <a class="admin-kit-button" href={pageLink(data.nextCursor)}>{t('下一頁', 'Next page')}</a>}
            </nav>
        </section>
    </> : <AlertBanner tone="danger" title={unavailable} unavailableLabel={unavailable}
        description={t('無法取得相關採購資料。', 'Related purchases could not be loaded.')}
        href={pathname + Astro.url.search} linkLabel={t('重試', 'Retry')} />}
    <section class="admin-kit-panel" data-collection-sleeve-gifts>
        <h2>{t('隨貨附贈的卡套', 'Complimentary sleeves')}</h2>
        {gifts === undefined ? <p>{unavailable}</p> : gifts.length === 0
            ? <p>{t('此收藏尚無附贈卡套紀錄。', 'No sleeve gifts are linked to this collection.')}</p>
            : <ul class="admin-collection-purchase-orders">
                {gifts.map(gift => <li>
                    <h3>{[gift.brand, gift.product_name].filter(Boolean).join(' ')}</h3>
                    <p>{gift.transaction_date} · {gift.width_tenth_mm/10} × {gift.height_tenth_mm/10} mm · {gift.quantity_sheets} {t('張','sleeves')}
                        {gift.pack_count !== null && <> · {gift.pack_count} {t('包','packs')}</>}
                        {gift.purchase_order_id !== null && <> · <a href={purchaseLink({id:String(gift.purchase_order_id)})}>{t('訂單','Order')} #{gift.purchase_order_id}</a></>}
                    </p>
                </li>)}
            </ul>}
    </section>
</section>
