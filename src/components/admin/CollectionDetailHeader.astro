---
import AdminIcon from './AdminIcon.astro';
import type { CollectionHeader } from '../../lib/collection-v2-management';
import { collectionItemTypeLabel } from '../../lib/collection-item-types';

interface Props {
  header?: CollectionHeader | null;
  scope: string;
  lang: 'zh-TW' | 'en';
  fallback: string;
  error?: string;
}
const {header, scope, lang, fallback, error} = Astro.props;
const t = (zh: string, en: string) => lang === 'en' ? en : zh;
const labels: Record<string, string> = {
  owned: t('已收藏','Owned'), preordered: t('預購中','Preordered'), wishlist: t('願望清單','Wishlist'),
  not_owned: t('未收藏','Not owned'), sold: t('已售出','Sold'), gifted_away: t('已贈出','Gifted away'),
  unknown: t('未知','Unknown'), archived: t('已封存','Archived'),
};
const tones: Record<string,string> = {owned:'success', wishlist:'wish', preordered:'preorder'};
const symbols: Record<string,string> = {owned:'✓', wishlist:'♡', preordered:'◷'};
const flags = new Set<string>();
if (header) {
  flags.add(header.owned === 1 ? 'owned' : header.acquisition_status === 'owned' ? 'not_owned' : header.acquisition_status);
  if (header.acquisition_status === 'preordered') flags.add('preordered');
  if (header.wishlist === 1) flags.add('wishlist');
  if (header.archived_at) flags.add('archived');
}
const id = Astro.params.id;
const canRelink = Boolean(id && header && !header.archived_at);
const prefix = lang === 'en' ? '/en' : '';
const source = header?.source_id?.match(/^(BGG|NotBGG):([0-9]+)$/);
const sourceHref = source ? prefix + (source[1] === 'BGG' ? '/games/bgg-' : '/games/notbgg/') + source[2] : null;
---
<header class="admin-detail-header" data-detail-header data-relink-id={canRelink ? id : undefined} data-relink-scope={scope} data-relink-lang={lang}>
  <a class="admin-kit-button" href={'/admin/collection?' + new URLSearchParams({scope, lang})}>
    <AdminIcon name="arrow-left" size={16} />{t('全部收藏','All collection records')}
  </a>
  {header ? (
    <div class="admin-detail-identity">
      <div class="admin-detail-cover">
        <span aria-hidden="true"><AdminIcon name="box" size={28} /></span>
        {header.image && <img src={header.image} alt="" width="72" height="96" referrerpolicy="no-referrer" />}
      </div>
      <div>
        <h1>{header.display_name}</h1>
        <p data-detail-game hidden={header.game_name === header.display_name}>{header.game_name}</p>
        <div class="admin-kit-row">
          <a data-detail-source href={sourceHref ?? undefined} hidden={!sourceHref}>{header.source_id}</a>
          {canRelink && <>
            {/* Icon-only entry; the tooltip and accessible name both say what it does. */}
            <button type="button" class="relink-icon" data-relink-open aria-haspopup="dialog" aria-controls="collection-relink-dialog"
              aria-label={t('更換對應遊戲','Change linked game')} data-tooltip={t('更換對應遊戲','Change linked game')}><AdminIcon name="sync" size={16} /></button>
            <button type="button" class="admin-kit-button" data-relink-history-open aria-haspopup="dialog"
              aria-controls="collection-relink-history" data-count={String(header.relink_count ?? 0)}
              data-revision={header.relink_revision == null ? undefined : String(header.relink_revision)}
              hidden={!header.relink_count}>{t('紀錄 ','History ') + new Intl.NumberFormat(lang).format(header.relink_count ?? 0)}</button>
          </>}
          <span data-detail-source-missing hidden={!!sourceHref}>{t('缺少來源身份','Missing source identity')}</span>
          <span data-detail-type>{collectionItemTypeLabel(header.item_type, lang === 'en')}</span>
          <span>{t('持有副本','Owned copies')} · {new Intl.NumberFormat(lang).format(header.copies)}</span>
        </div>
        <div class="admin-kit-row">
          {[...flags].map(flag => <span class="admin-kit-badge" data-tone={tones[flag] ?? 'neutral'}>
            <span aria-hidden="true">{symbols[flag] ?? '•'}</span>{labels[flag] ?? flag}
          </span>)}
        </div>
      </div>
    </div>
  ) : (
    <div>
      <h1>{fallback}</h1>
      <p role="alert">{error ?? t('無法取得收藏頁首。','Collection header unavailable.')}</p>
    </div>
  )}
  {canRelink && <>
    <p data-relink-success role="status"></p>
    <dialog class="admin-kit-dialog collection-relink" data-relink id="collection-relink-dialog" aria-labelledby="collection-relink-title">
      <div class="admin-kit-row relink-dialog-heading">
        <h2 id="collection-relink-title">{t('更換對應遊戲','Change linked game')}</h2>
        <button type="button" class="admin-kit-button" data-relink-close>{t('關閉','Close')}</button>
      </div>
      <p data-relink-status role="status" tabindex="-1"></p>
      <form data-relink-search class="relink-search">
        <label>{t('名稱、BGG:ID 或 NotBGG:ID','Name, BGG:ID or NotBGG:ID')}<input name="q" type="search" maxlength="200" required autofocus /></label>
        <button class="admin-kit-button" type="submit">{t('搜尋','Search')}</button>
      </form>
      <div class="relink-results" data-relink-results></div>
      <p data-relink-empty hidden>{t('找不到遊戲。','No games found.')} <a href={'/admin/bgg?lang='+lang}>{t('先到 BGG 同步','Sync from BGG first')}</a></p>
      <form data-relink-confirm hidden>
        <p data-relink-games></p>
        <p data-relink-types></p>
        <p data-relink-duplicate hidden>{t('已有其他收藏對應這款遊戲，仍可更換。','Other records link to this game. You can still proceed.')}</p>
        <p data-relink-affected></p>
        <p data-relink-preserved></p>
        <label><input type="checkbox" name="rename" />{t('同時改成新遊戲的名稱','Also use the new game name')}</label>
        <label data-relink-type-confirm hidden><input type="checkbox" name="confirmType" />{t('確認變更收藏類型','Confirm the collection type change')}</label>
        <button class="admin-kit-button" type="submit" disabled>{t('確認更換','Confirm change')}</button>
      </form>
    </dialog>
    <dialog class="admin-kit-dialog collection-relink" data-relink-history-dialog id="collection-relink-history" aria-labelledby="collection-relink-history-title">
      <div class="admin-kit-row relink-dialog-heading">
        <h2 id="collection-relink-history-title">{t('更換紀錄','Change history')}</h2>
        <button type="button" class="admin-kit-button" data-relink-close autofocus>{t('關閉','Close')}</button>
      </div>
      <p data-relink-history-status role="status"></p>
      <ol data-relink-history></ol>
    </dialog>
  </>}
</header>
<script>
  import { initializeCollectionRelink } from '../../lib/collection-relink-controller';

  // The basic editor supplies its current revision and updates its local form after a relink.
  for (const header of document.querySelectorAll<HTMLElement>('[data-relink-id]')) {
    if (!header.closest('[data-collection-admin]')) initializeCollectionRelink(header);
  }
  for (const image of document.querySelectorAll<HTMLImageElement>('.admin-detail-cover img')) {
    image.addEventListener('error', () => { image.hidden = true; }, {once:true});
    if (image.complete && !image.naturalWidth) image.hidden = true;
  }
</script>
<style is:global>
  .admin-page .admin-detail-header button[data-relink-history-open] {
    min-height: 44px;
    padding-inline: .65rem;
  }
  /* Small icon button with a 44px touch target; the visible chip is 28px. */
  .admin-page .admin-detail-header button.relink-icon {
    position: relative; display: inline-grid; place-items: center;
    inline-size: 44px; block-size: 44px; min-height: 44px; padding: 0; margin-inline: -6px;
    border: 0; background: transparent; color: var(--ink-muted); cursor: pointer;
  }
  .admin-page .admin-detail-header button.relink-icon::before {
    content: ''; position: absolute; inset: 8px; border-radius: 50%;
    border: 1px solid var(--border-strong); background: var(--bg-surface);
  }
  .admin-page .admin-detail-header button.relink-icon svg { position: relative; }
  .admin-page .admin-detail-header button.relink-icon:hover { color: var(--brand-purple-strong); }
  .admin-page .admin-detail-header button.relink-icon:hover::before { background: var(--brand-purple-soft); }
  /* Tooltip on hover and keyboard focus. */
  .admin-page .admin-detail-header button.relink-icon[data-tooltip]::after {
    content: attr(data-tooltip); position: absolute; inset-block-end: calc(100% + 2px); inset-inline-start: 50%;
    transform: translateX(-50%); padding: .25rem .5rem; border-radius: var(--radius-sm);
    background: var(--ink); color: var(--bg-surface); font: var(--text-small); white-space: nowrap;
    pointer-events: none; opacity: 0; transition: opacity .12s ease; z-index: 5;
  }
  .admin-page .admin-detail-header button.relink-icon:is(:hover, :focus-visible)::after { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .admin-page .admin-detail-header button.relink-icon[data-tooltip]::after { transition: none; }
  }
  .admin-detail-header .collection-relink {
    inline-size: 32rem;
    max-block-size: calc(100% - 2rem);
    overflow: auto;
    overflow-wrap: anywhere;
  }
  .admin-detail-header .collection-relink .relink-dialog-heading { justify-content: space-between; }
  .admin-detail-header .collection-relink .relink-dialog-heading h2 { margin: 0; }
  .admin-detail-header .collection-relink .relink-search { display: flex; flex-wrap: wrap; align-items: end; gap: .5rem; }
  .admin-page .collection-relink .relink-search label { flex: 1 1 13rem; margin: 0; }
  .admin-page .collection-relink .relink-search input { inline-size: 100%; min-inline-size: 0; box-sizing: border-box; }
  .admin-detail-header .collection-relink .relink-results { display: flex; flex-wrap: wrap; gap: .5rem; margin-block: .75rem; }
  .admin-page .collection-relink button { min-height: 44px; overflow-wrap: anywhere; }
  .admin-detail-header [data-relink-success]:not(:empty) {
    padding: .5rem .75rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
  }
</style>
