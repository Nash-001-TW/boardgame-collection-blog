---
import { env } from 'cloudflare:workers';
import PhysicalComponentFields from '../PhysicalComponentFields.astro';
import D1QuantityPreviewDialog from './D1QuantityPreviewDialog.astro';
import D1QuantityHistory from './D1QuantityHistory.astro';
import { readQuantityHistory, type QuantityHistory } from '../../lib/d1-quantity-history';
import { classifyStoredComponents } from '../../lib/component-classifier-adapter';
import { maxComponentQuantity } from '../../lib/physical-component-values';

interface Props { collectionId: number; scope: 'production' | 'test'; lang: 'en' | 'zh-TW'; }
const { collectionId, scope, lang } = Astro.props;
const en = lang === 'en';
const t = (zh: string, english: string) => en ? english : zh;
const title = t('管理實體組件', 'Manage physical components');
const secret = (env as unknown as Record<string, unknown>).PHYSICAL_COMPONENT_SIGNING_KEY;
const signingConfigured = typeof secret === 'string' && new TextEncoder().encode(secret).length >= 32;
interface Collection { display_name: string; record_scope: string; archived_at: string | null; }
let collection: Collection | null = null;
interface Definition {
    id: number; component_name: string; component_type: string; quantity_unit: string;
    expected_quantity: number | null; physical_revision: number;
}
interface Copy { id: number; copy_label: string | null; }
interface Requirement {
    id: number; component_definition_id: number | null; quantity_sheets: number;
    assignment_revision: number; width: number; height: number;
}
interface Count { owned_copy_id: number; component_definition_id: number; actual_quantity: number | null; count_revision: number; }
let definitions: Definition[] = [];
let copies: Copy[] = [];
let requirements: Requirement[] = [];
let counts: Count[] = [];
let classifications = new Map<number, Awaited<ReturnType<typeof classifyStoredComponents>>[number]>();
let error = '';
let history: QuantityHistory = { status: 'unavailable' };
try {
    const db = env.DB;
    collection = await db.prepare(`
                SELECT c.display_name, c.record_scope, m.archived_at FROM v2_collection_items c
                LEFT JOIN v2_collection_management m ON m.collection_item_id = c.id WHERE c.id = ?
            `).bind(collectionId).first<Collection>();
    if (!collection || collection.record_scope !== scope) {
        Astro.response.status = 404;
        error = t('找不到收藏。', 'Collection not found.');
    } else {
        const [list, copyList, sleeveList, countList] = await Promise.all([
            db.prepare(`SELECT id, component_name, component_type, quantity_unit, expected_quantity, physical_revision
                        FROM v2_component_definitions WHERE collection_item_id = ? AND physical_creation_token IS NOT NULL
                        ORDER BY id`).bind(collectionId).all<Definition>(),
            db.prepare(`SELECT id, copy_label FROM v2_owned_copies WHERE collection_item_id = ?
                        AND inventory_status = 'in_collection' AND seal_status <> 'sealed' ORDER BY id`).bind(collectionId).all<Copy>(),
            db.prepare(`SELECT r.id, r.component_definition_id, r.quantity_sheets, r.assignment_revision,
                        s.width_tenth_mm AS width, s.height_tenth_mm AS height
                        FROM v2_sleeve_requirements r JOIN v2_sleeve_sizes s ON s.id = r.size_id
                        WHERE r.collection_item_id = ? ORDER BY r.id`).bind(collectionId).all<Requirement>(),
            db.prepare(`SELECT k.owned_copy_id, k.component_definition_id, k.actual_quantity, k.count_revision
                        FROM v2_copy_components k JOIN v2_owned_copies c ON c.id = k.owned_copy_id
                        JOIN v2_component_definitions d ON d.id = k.component_definition_id
                        WHERE c.collection_item_id = ? AND d.collection_item_id = c.collection_item_id
                          AND d.physical_creation_token IS NOT NULL`).bind(collectionId).all<Count>(),
        ]);
        if (![list, copyList, sleeveList, countList].every(result => result.success)) throw new Error('Read failed');
        definitions = list.results;
        copies = copyList.results;
        requirements = sleeveList.results;
        counts = countList.results;
        classifications = new Map((await classifyStoredComponents(db, definitions.map(row => row.id), { secret }))
            .map(result => [result.definitionId, result]));
        history = await readQuantityHistory(db, collectionId, en);
    }
} catch {
    Astro.response.status = 503;
    error = t('無法讀取實體組件資料。', 'Physical component data could not be loaded.');
}
const countsByDefinition = new Map<number, Map<number, Count>>();
for (const count of counts) {
    const rows = countsByDefinition.get(count.component_definition_id) ?? new Map<number, Count>();
    rows.set(count.owned_copy_id, count);
    countsByDefinition.set(count.component_definition_id, rows);
}
const canWrite = signingConfigured && !error && collection?.archived_at === null;
const unassigned = requirements.filter(row => row.component_definition_id === null);
---

    <div class="physical-manager" data-physical-manager data-lang={lang}>
        <nav>
            <a href={'/admin/collection/components/classification' + (en ? '?lang=en' : '')}>{t('組件分類', 'Component classification')}</a>
        </nav>
        <h2>{title}</h2>
        {error && <p role="alert">{error}</p>}
        {collection && !error && <>
            <h2>{collection.display_name} (#{collectionId}, {collection.record_scope})</h2>
            <p data-physical-status role="status" aria-live="polite" tabindex="-1"></p>
            {!signingConfigured && <p role="alert">{t('來源簽章尚未設定。', 'Source signing is unavailable.')}</p>}
            {collection.archived_at && <p>{t('此收藏已封存。', 'This collection is archived.')}</p>}
            {canWrite && <section>
                <h3>{t('新增實體組件', 'Add physical component')}</h3>
                <form method="post" data-physical-action="create" class="fields">
                    <input type="hidden" name="collectionId" value={collectionId} />
                    <PhysicalComponentFields en={en} />
                    <label><input type="checkbox" name="confirmed" required /> {t('我已確認此組件屬於本收藏', 'I verified this physical component belongs to this collection')}</label>
                    <button class="admin-button primary">{t('新增', 'Add')}</button>
                </form>
            </section>}
            <section>
                <h3>{t('實體組件清單', 'Physical component list')}</h3>
                {!definitions.length && <p>{t('尚無由受控流程建立的組件。', 'No components have been created through the managed workflow.')}</p>}
                {definitions.map(component => {
                    const result = classifications.get(component.id);
                    const verified = result?.classification === 'PHYSICAL_COMPONENT';
                    const componentCounts = countsByDefinition.get(component.id);
                    const assigned = requirements.filter(row => row.component_definition_id === component.id);
                    return <article>
                        <h4>#{component.id} {component.component_name}</h4>
                        <p><span class="status-badge" data-classification={verified ? 'PHYSICAL_COMPONENT' : 'UNKNOWN'}>{verified ? t('已確認實體組件', 'Confirmed physical component') : t('待確認', 'Pending verification')}</span>
                           {' · '}{t('預期數量', 'Expected quantity')} {component.expected_quantity ?? '—'} ({component.quantity_unit})</p>
                        {!verified && <p role="alert">{t('來源證據不可用或有衝突。', 'Source evidence is unavailable or conflicting.')}</p>}
                        {assigned.length > 0 && <p>{t('已關聯卡套需求', 'Assigned sleeve requirements')}
                            {' '}{assigned.map(row => '#' + row.id + ' (' + row.quantity_sheets + ')').join(', ')}</p>}
                        {canWrite && verified && <>
                            <details>
                                <summary>{t('編輯組件', 'Edit component')}</summary>
                                <form method="post" data-physical-action="edit" class="fields">
                                    <div class="quantity-notice" data-quantity-notice hidden>
                                        <p role="alert" tabindex="-1" data-quantity-message></p>
                                        <button type="button" class="admin-button" data-quantity-action="preview" hidden>{t('重新預覽', 'Preview again')}</button>
                                    </div>
                                    <input type="hidden" name="definitionId" value={component.id} />
                                    <input type="hidden" name="definitionRevision" value={component.physical_revision} />
                                    <input type="hidden" name="previousExpected" value={component.expected_quantity ?? ''} />
                                    <PhysicalComponentFields en={en} component={component} />
                                    <label data-quantity-reason hidden>{t('更正理由（必填）', 'Correction reason (required)')}
                                        <textarea name="reason" maxlength="1000" rows="2"></textarea>
                                    </label>
                                    <button type="submit" class="admin-button" data-quantity-submit>{t('儲存', 'Save')}</button>
                                    <div class="quantity-recovery" data-quantity-recovery hidden>
                                        <p role="status" tabindex="-1" data-quantity-recovery-message></p>
                                        <p>{t('待確認的操作識別', 'Pending operation ID')} <code data-quantity-operation-id></code></p>
                                        <button type="button" class="admin-button" data-quantity-action="status">{t('查詢結果', 'Check result')}</button>
                                        <button type="button" class="admin-button primary" data-quantity-action="retry" hidden>{t('重新送出同一次更正（不會重複寫入）', 'Resend the same correction (no duplicate write)')}</button>
                                    </div>
                                </form>
                            </details>
                        </>}
                        <D1QuantityHistory en={en} history={history} definitionId={component.id} />
                        {canWrite && verified && <>
                            {copies.length ? <form method="post" data-physical-action="count" class="fields">
                                <input type="hidden" name="definitionId" value={component.id} />
                                <input type="hidden" name="definitionRevision" value={component.physical_revision} />
                                <label>{t('清點副本（顯示目前實點）', 'Count copy (current actual quantity)')}
                                    <select name="copyId" required>
                                        <option value="">{t('選擇副本', 'Select a copy')}</option>
                                        {copies.map(copy => {
                                            const count = componentCounts?.get(copy.id);
                                            return <option value={copy.id} data-revision={count?.count_revision ?? 0}>
                                                #{copy.id} {copy.copy_label} · {count?.actual_quantity ?? t('未清點', 'Uncounted')}
                                            </option>;
                                        })}
                                    </select>
                                </label>
                                <label>{t('實際數量', 'Actual quantity')} <input name="actual" type="number" required min="0" max={maxComponentQuantity} step="1" /></label>
                                <button class="admin-button">{t('儲存清點', 'Save count')}</button>
                            </form> : <p>{t('沒有可清點的在藏未封膜副本。', 'No eligible unsealed copies are in the collection.')}</p>}
                            {result.canAssignToSleeves && (unassigned.length ? <form method="post" data-physical-action="assign" class="fields">
                                <input type="hidden" name="definitionId" value={component.id} />
                                <input type="hidden" name="definitionRevision" value={component.physical_revision} />
                                <label>{t('尚未指派的卡套需求', 'Unassigned sleeve requirement')}
                                    <select name="requirementId" required>
                                        <option value="">{t('選擇需求', 'Select a requirement')}</option>
                                        {unassigned.map(row => <option value={row.id} data-revision={row.assignment_revision}>
                                            #{row.id} · {row.width / 10} × {row.height / 10} mm · {row.quantity_sheets} {t('張', 'sleeves')}
                                        </option>)}
                                    </select>
                                </label>
                                <button class="admin-button">{t('關聯需求', 'Assign requirement')}</button>
                            </form> : <p>{t('沒有尚未指派的卡套需求。', 'No unassigned sleeve requirements.')}</p>)}
                        </>}
                    </article>;
                })}
            </section>
        </>}
        <D1QuantityPreviewDialog en={en} copies={copies} />
    </div>

<script>
    import '../../lib/physical-component-admin-controller';
</script>

<style>
    .physical-manager { min-width: 0; padding: 16px; background: var(--bg-surface); border-radius: 12px; }
    .fields > label { min-width: 0; max-width: 100%; }
    .fields :is(input, select, textarea) { max-width: 100%; }
    nav, .fields { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; }
    .fields { margin: 12px 0; }
    .fields label { display: grid; gap: 4px; }
    .fields [data-quantity-reason][hidden], .fields [data-quantity-action][hidden] { display: none; }
    .quantity-notice, .quantity-recovery { flex-basis: 100%; padding: 12px; border-radius: 8px; overflow-wrap: anywhere; }
    .quantity-notice { background: #FFE8E4; color: #B42318; }
    .quantity-recovery { background: #FEF2DD; color: #4A3B33; }
    [data-quantity-action], [data-quantity-submit] { min-height: 44px; }
    [data-quantity-notice][data-tone="success"] { padding: 12px; border-radius: 8px; background: #E8F3E3; color: #2B1914; }
    article, section { border-top: 1px solid #dad8d0; margin-top: 20px; padding-top: 12px; }
    summary { cursor: pointer; }
</style>
