---
import { env } from 'cloudflare:workers';
import PhysicalComponentFields from '../PhysicalComponentFields.astro';
import D1QuantityPreviewDialog from './D1QuantityPreviewDialog.astro';
import D1QuantityHistory from './D1QuantityHistory.astro';
import { readQuantityHistory, type QuantityHistory } from '../../lib/d1-quantity-history';
import { classifyStoredComponents } from '../../lib/component-classifier-adapter';
import { earliestCountDate, maxComponentQuantity, todayInTaipei } from '../../lib/physical-component-values';
import { readApplicabilityHistory } from '../../lib/component-applicability';
import AdminIcon from './AdminIcon.astro';
import ComponentPhotoDialog from './ComponentPhotoDialog.astro';

interface Props { collectionId: number; scope: 'production' | 'test'; lang: 'en' | 'zh-TW'; }
const { collectionId, scope, lang } = Astro.props;
const en = lang === 'en';
const t = (zh: string, english: string) => en ? english : zh;
// Same unit wording as PhysicalComponentFields, so the count list never shows raw codes such as "piece".
const unitLabels: Record<string, string> = {
    piece: t('件', 'piece'), card: t('張', 'card'), tile: t('塊', 'tile'), die: t('顆', 'die'),
    sheet: t('頁', 'sheet'), box: t('盒', 'box'), pack: t('包', 'pack'), set: t('組', 'set'), other: t('其他', 'other'),
};
const unitLabel = (unit: string) => unitLabels[unit] ?? unit;
const countToday = todayInTaipei();
const title = t('管理實體組件', 'Manage physical components');
const secret = (env as unknown as Record<string, unknown>).PHYSICAL_COMPONENT_SIGNING_KEY;
const signingConfigured = typeof secret === 'string' && new TextEncoder().encode(secret).length >= 32;
interface Collection { display_name: string; record_scope: string; archived_at: string | null; }
let collection: Collection | null = null;
interface Definition {
    id: number; component_name: string; component_type: string; quantity_unit: string;
    expected_quantity: number | null; physical_revision: number;
}
interface Copy { id: number; copy_label: string | null; }
interface Requirement {
    id: number; component_definition_id: number | null; quantity_sheets: number;
    assignment_revision: number; width: number; height: number;
}
interface Count { owned_copy_id: number; component_definition_id: number; actual_quantity: number | null; count_revision: number; counted_on: string | null; }
let definitions: Definition[] = [];
let copies: Copy[] = [];
let requirements: Requirement[] = [];
let counts: Count[] = [];
let classifications = new Map<number, Awaited<ReturnType<typeof classifyStoredComponents>>[number]>();
let error = '';
let history: QuantityHistory = { status: 'unavailable' };
let applicabilityHistory: Awaited<ReturnType<typeof readApplicabilityHistory>> = [];
try {
    const db = env.DB;
    collection = await db.prepare(`
                SELECT c.display_name, c.record_scope, m.archived_at FROM v2_collection_items c
                LEFT JOIN v2_collection_management m ON m.collection_item_id = c.id WHERE c.id = ?
            `).bind(collectionId).first<Collection>();
    if (!collection || collection.record_scope !== scope) {
        Astro.response.status = 404;
        error = t('找不到收藏。', 'Collection not found.');
    } else {
        const [list, copyList, sleeveList, countList] = await Promise.all([
            db.prepare(`SELECT id, component_name, component_type, quantity_unit, expected_quantity, physical_revision
                        FROM v2_component_definitions WHERE collection_item_id = ? AND physical_creation_token IS NOT NULL
                        ORDER BY id`).bind(collectionId).all<Definition>(),
            db.prepare(`SELECT id, copy_label FROM v2_owned_copies WHERE collection_item_id = ?
                        AND inventory_status = 'in_collection' AND seal_status <> 'sealed' ORDER BY id`).bind(collectionId).all<Copy>(),
            db.prepare(`SELECT r.id, r.component_definition_id, r.quantity_sheets, r.assignment_revision,
                        s.width_tenth_mm AS width, s.height_tenth_mm AS height
                        FROM v2_sleeve_requirements r JOIN v2_sleeve_sizes s ON s.id = r.size_id
                        WHERE r.collection_item_id = ? ORDER BY r.id`).bind(collectionId).all<Requirement>(),
            db.prepare(`SELECT k.owned_copy_id, k.component_definition_id, k.actual_quantity, k.count_revision, k.counted_on
                        FROM v2_copy_components k JOIN v2_owned_copies c ON c.id = k.owned_copy_id
                        JOIN v2_component_definitions d ON d.id = k.component_definition_id
                        WHERE c.collection_item_id = ? AND d.collection_item_id = c.collection_item_id
                          AND d.physical_creation_token IS NOT NULL`).bind(collectionId).all<Count>(),
        ]);
        if (![list, copyList, sleeveList, countList].every(result => result.success)) throw new Error('Read failed');
        definitions = list.results;
        copies = copyList.results;
        requirements = sleeveList.results;
        counts = countList.results;
        classifications = new Map((await classifyStoredComponents(db, definitions.map(row => row.id), { secret }))
            .map(result => [result.definitionId, result]));
        history = await readQuantityHistory(db, collectionId, en);
        applicabilityHistory = await readApplicabilityHistory(db, collectionId);
    }
} catch {
    Astro.response.status = 503;
    error = t('無法讀取實體組件資料。', 'Physical component data could not be loaded.');
}
const countsByDefinition = new Map<number, Map<number, Count>>();
for (const count of counts) {
    const rows = countsByDefinition.get(count.component_definition_id) ?? new Map<number, Count>();
    rows.set(count.owned_copy_id, count);
    countsByDefinition.set(count.component_definition_id, rows);
}
const canWrite = signingConfigured && !error && collection?.archived_at === null;
interface Photo { id: number; definition_id: number; object_key: string; thumb_key: string; revision: number; is_public: number; }
const photos = new Map<number, Photo>();
const photoUrl = '/api/admin/collection/component-photos/';
let photoUnavailable = false;
if (!error && definitions.length) {
    try {
        const result = await env.DB.prepare(`SELECT p.id,p.definition_id,p.object_key,p.thumb_key,p.revision,p.is_public
            FROM v2_component_photos p JOIN v2_component_definitions d ON d.id=p.definition_id
            WHERE d.collection_item_id=? AND p.language_code IS NULL`).bind(collectionId).all<Photo>();
        if (!result.success) throw new Error('Photo metadata unavailable');
        for (const photo of result.results) photos.set(photo.definition_id, photo);
    } catch {
        photoUnavailable = true;
        console.warn('Component photo metadata unavailable');
    }
}
const photoLabel = t('設定照片', 'Component photo');
const photoButton = (component: Definition, verified: boolean) => {
    const photo = photos.get(component.id);
    const writable = canWrite && verified && !photoUnavailable;
    return {
        'data-component-photo-open': component.id,
        'data-photo-name': component.component_name,
        'data-photo-writable': writable ? '1' : '0',
        'data-photo-id': photo?.id,
        'data-photo-revision': photo?.revision,
        'data-photo-public': photo?.is_public,
        'data-photo-full': photo?.object_key,
        'data-photo-thumb': photo?.thumb_key,
        disabled: !photo && !writable,
    };
};
const requestedCopy = Astro.url.searchParams.get('copy');
const selectedCopy = copies.find(copy => String(copy.id) === requestedCopy) ?? copies[0];
const copyLink = '/admin/collection/' + collectionId + '/copies?' + new URLSearchParams({
    scope, ...(en ? { lang: 'en' } : {}),
});
const unassigned = requirements.filter(row => row.component_definition_id === null);
const applicabilityByPair = new Map<string, typeof applicabilityHistory[number]>();
for (const event of applicabilityHistory) {
    const key = event.definitionId + ':' + event.copyId;
    if ((applicabilityByPair.get(key)?.revision ?? 0) < event.revision) applicabilityByPair.set(key, event);
}
const eventDate = new Intl.DateTimeFormat(en ? 'en' : 'zh-TW', {
    timeZone: 'Asia/Taipei', dateStyle: 'medium', timeStyle: 'medium',
});
---

    <div class="physical-manager" data-physical-manager data-lang={lang}>
        <ComponentPhotoDialog en={en} />
        {photoUnavailable && <p role="status">{t('目前無法讀取照片資料。', 'Photo data is unavailable.')}</p>}
        <nav>
            <a href={'/admin/collection/components/classification' + (en ? '?lang=en' : '')}>{t('組件分類', 'Component classification')}</a>
        </nav>
        <h2>{title}</h2>
        {error && <p role="alert">{error}</p>}
        {collection && !error && <>
            <h2>{collection.display_name} (#{collectionId}, {collection.record_scope})</h2>
            <p data-physical-status role="status" aria-live="polite" tabindex="-1"></p>
            {!signingConfigured && <p role="alert">{t('來源簽章尚未設定。', 'Source signing is unavailable.')}</p>}
            {collection.archived_at && <p>{t('此收藏已封存。', 'This collection is archived.')}</p>}
            <section data-count-picker aria-labelledby="count-copy-heading">
                <h3 id="count-copy-heading">{t('清點副本', 'Count copy')}</h3>
                {selectedCopy ? <div class="count-controls">
                    <label>{t('副本', 'Copy')}
                        <select data-count-copy>
                            {copies.map(copy => <option value={copy.id} selected={copy.id === selectedCopy.id}>#{copy.id} {copy.copy_label}</option>)}
                        </select>
                    </label>
                    <button type="button" class="admin-button" data-count-step="-1" disabled={selectedCopy.id === copies[0].id}>{t('上一個', 'Previous')}</button>
                    <button type="button" class="admin-button" data-count-step="1" disabled={selectedCopy.id === copies.at(-1)?.id}>{t('下一個', 'Next')}</button>
                    <label>{t('清點日期', 'Count date')}
                        <input type="date" data-count-date required min={earliestCountDate} max={countToday}
                            value={countToday} aria-describedby="count-date-status" disabled={!canWrite} />
                    </label>
                </div> : <p>{t('沒有可清點的在藏未封膜副本。', 'No eligible unsealed copies are in the collection.')}
                    {' '}<a href={copyLink}>{t('副本與品況', 'Copies and condition')}</a>
                </p>}
                <p id="count-date-status" data-count-date-status role="status" hidden></p>
            </section>
            <section data-count-list aria-labelledby="count-list-heading">
                <h3 id="count-list-heading">{t('清點清單', 'Count list')}</h3>
                {!definitions.length && <p>{t('尚無由受控流程建立的組件。', 'No components have been created through the managed workflow.')}</p>}
                {definitions.map(component => {
                    const verified = classifications.get(component.id)?.classification === 'PHYSICAL_COMPONENT';
                    const componentCounts = countsByDefinition.get(component.id);
                    const current = selectedCopy && componentCounts?.get(selectedCopy.id);
                    const actual = current ? current.actual_quantity : null;
                    const componentName = '#' + component.id + ' ' + component.component_name;
                    const expectedText = t('預期', 'Expected') + ' ' + (component.expected_quantity ?? '—') + ' ' + unitLabel(component.quantity_unit);
                    const pair = selectedCopy && applicabilityByPair.get(component.id + ':' + selectedCopy.id);
                    const excluded = verified && pair?.notApplicable === 1;
                    return <article data-count-row class:list={{ 'count-excluded': excluded }}>
                        <button type="button" class="component-thumb" data-component-thumb {...photoButton(component, verified)}
                            aria-label={photoLabel + ' · ' + component.component_name}>
                            {photos.has(component.id)
                                ? <img src={photoUrl + photos.get(component.id)!.thumb_key} alt="" loading="lazy" />
                                : <AdminIcon name="puzzle" size={32} />}
                        </button>
                        <div class="count-row-body">
                        <h4>#{component.id} {component.component_name}</h4>
                        {(!verified || !selectedCopy) && <p class="count-meta">{expectedText}</p>}
                        {!verified ? <p>{t('待確認，不可清點。來源證據不可用或有衝突。', 'Pending verification. Counting is unavailable because source evidence is unavailable or conflicting.')}</p>
                            : selectedCopy && <div data-count-values={JSON.stringify(copies.map(copy => {
                                const count = componentCounts?.get(copy.id);
                                return [String(copy.id), { actual: count?.actual_quantity ?? null, revision: count?.count_revision ?? 0, countedOn: count?.counted_on ?? null }];
                            }))} data-applicability-values={JSON.stringify(copies.map(copy => {
                                const event = applicabilityByPair.get(component.id + ':' + copy.id);
                                return [String(copy.id), { revision: event?.revision ?? 0, excluded: event?.notApplicable === 1 }];
                            }))} data-component-name={componentName}>
                                <p class="count-meta">{expectedText}<span class="count-meta-counts">{' · '}{t('實點', 'Count')}{' '}<span data-count-current>{actual ?? t('未清點', 'Uncounted')}</span>{' · '}{t('清點日期', 'Count date')}{' '}<span data-counted-on>{current?.counted_on ?? t('未記錄', 'Not recorded')}</span></span></p>
                                <p data-applicability-excluded hidden={!excluded}>{t('此副本不適用', 'Not applicable to this copy')}</p>
                                <div class="count-actions">
                                <div data-applicable-count hidden={excluded}>
                                {canWrite && <form method="post" data-physical-action="count" class="count-controls">
                                    <input type="hidden" name="definitionId" value={component.id} />
                                    <input type="hidden" name="definitionRevision" value={component.physical_revision} />
                                    <input type="hidden" name="copyId" value={selectedCopy.id} />
                                    <input type="hidden" name="revision" value={current ? current.count_revision : 0} />
                                    <label>{t('實際數量', 'Actual quantity')}
                                        <input name="actual" type="number" required min="0" max={maxComponentQuantity} step="1" value={actual ?? ''} />
                                    </label>
                                    <button type="submit" class="admin-button" data-count-save disabled>{t('儲存', 'Save')}</button>
                                    <p data-count-status role="status" aria-live="polite"></p>
                                    <button type="button" class="admin-button" data-count-retry hidden>{t('重試', 'Retry')}</button>
                                    <button type="button" class="admin-button" data-count-reload hidden>{t('重新載入', 'Reload')}</button>
                                </form>}
                                </div>
                                {canWrite && <div class="count-controls">
                                    <button type="button" class="admin-button" data-applicability-toggle>
                                        {excluded ? t('恢復適用', 'Restore applicability') : t('此副本不適用', 'Mark not applicable to this copy')}
                                    </button>
                                    <p data-applicability-status role="status" aria-live="polite"></p>
                                    <button type="button" class="admin-button" data-applicability-retry hidden>{t('重試', 'Retry')}</button>
                                    <button type="button" class="admin-button" data-applicability-reload hidden>{t('重新載入', 'Reload')}</button>
                                </div>}
                                </div>
                            </div>}
                        </div>
                    </article>;
                })}
            </section>
            <details data-component-management open={!definitions.length}>
                <summary>{t('組件管理（影響所有副本）', 'Component management (affects all copies)')}</summary>
            {canWrite && <section>
                <h3>{t('新增實體組件', 'Add physical component')}</h3>
                <form method="post" data-physical-action="create" class="fields">
                    <input type="hidden" name="collectionId" value={collectionId} />
                    <p data-create-status role="status" aria-live="polite" tabindex="-1"></p>
                    <PhysicalComponentFields en={en} />
                    {selectedCopy ? <>
                        <label>{t('這份副本的實際數量（選填）', 'Actual quantity for this copy (optional)')}
                            <input name="actual" type="number" min="0" max={maxComponentQuantity} step="1" />
                        </label>
                        <button type="button" class="admin-button" data-create-match-expected disabled>{t('與預期相同', 'Same as expected')}</button>
                    </> : <p>{t('沒有可清點的在藏未封膜副本。', 'No eligible unsealed copies are in the collection.')}</p>}
                    <label><input type="checkbox" name="confirmed" required /> {t('我已確認此組件屬於本收藏', 'I verified this physical component belongs to this collection')}</label>
                    <button type="submit" class="admin-button primary">{t('新增', 'Add')}</button>
                </form>
            </section>}
            <section data-physical-component-list>
                <h3>{t('實體組件清單', 'Physical component list')}</h3>
                {!definitions.length && <p>{t('尚無由受控流程建立的組件。', 'No components have been created through the managed workflow.')}</p>}
                {definitions.map(component => {
                    const result = classifications.get(component.id);
                    const verified = result?.classification === 'PHYSICAL_COMPONENT';
                    const assigned = requirements.filter(row => row.component_definition_id === component.id);
                    return <article>
                        <h4>#{component.id} {component.component_name}</h4>
                        <button type="button" class="admin-button component-photo-manage" {...photoButton(component, verified)}>
                            {photos.has(component.id) && <img src={photoUrl + photos.get(component.id)!.thumb_key} alt="" loading="lazy" />}
                            {photoLabel}
                        </button>
                        <p><span class="status-badge" data-classification={verified ? 'PHYSICAL_COMPONENT' : 'UNKNOWN'}>{verified ? t('已確認實體組件', 'Confirmed physical component') : t('待確認', 'Pending verification')}</span>
                           {' · '}{t('預期數量', 'Expected quantity')} {component.expected_quantity ?? '—'} ({component.quantity_unit})</p>
                        {!verified && <p role="alert">{t('來源證據不可用或有衝突。', 'Source evidence is unavailable or conflicting.')}</p>}
                        {assigned.length > 0 && <p>{t('已關聯卡套需求', 'Assigned sleeve requirements')}
                            {' '}{assigned.map(row => '#' + row.id + ' (' + row.quantity_sheets + ')').join(', ')}</p>}
                        {canWrite && verified && <>
                            <details>
                                <summary>{t('編輯組件', 'Edit component')}</summary>
                                <form method="post" data-physical-action="edit" class="fields">
                                    <div class="quantity-notice" data-quantity-notice hidden>
                                        <p role="alert" tabindex="-1" data-quantity-message></p>
                                        <button type="button" class="admin-button" data-quantity-action="preview" hidden>{t('重新預覽', 'Preview again')}</button>
                                    </div>
                                    <input type="hidden" name="definitionId" value={component.id} />
                                    <input type="hidden" name="definitionRevision" value={component.physical_revision} />
                                    <input type="hidden" name="previousExpected" value={component.expected_quantity ?? ''} />
                                    <PhysicalComponentFields en={en} component={component} />
                                    <label data-quantity-reason hidden>{t('更正理由（必填）', 'Correction reason (required)')}
                                        <textarea name="reason" maxlength="1000" rows="2"></textarea>
                                    </label>
                                    <button type="submit" class="admin-button" data-quantity-submit>{t('儲存', 'Save')}</button>
                                    <div class="quantity-recovery" data-quantity-recovery hidden>
                                        <p role="status" tabindex="-1" data-quantity-recovery-message></p>
                                        <p>{t('待確認的操作識別', 'Pending operation ID')} <code data-quantity-operation-id></code></p>
                                        <button type="button" class="admin-button" data-quantity-action="status">{t('查詢結果', 'Check result')}</button>
                                        <button type="button" class="admin-button primary" data-quantity-action="retry" hidden>{t('重新送出同一次更正（不會重複寫入）', 'Resend the same correction (no duplicate write)')}</button>
                                    </div>
                                </form>
                            </details>
                        </>}
                        <D1QuantityHistory en={en} history={history} definitionId={component.id} />
                        <details data-applicability-history={component.id}>
                            <summary>{t('適用性歷史', 'Applicability history')}</summary>
                            <p data-applicability-empty hidden={applicabilityHistory.some(event => event.definitionId === component.id)}>
                                {t('尚無適用性紀錄', 'No applicability records yet')}
                            </p>
                            <ul>{applicabilityHistory.filter(event => event.definitionId === component.id).map(event =>
                                <li>
                                    <time datetime={new Date(event.occurredAt * 1000).toISOString()}>{eventDate.format(event.occurredAt * 1000)}</time>
                                    {' · #' + event.copyId + ' ' + (event.copyLabel ?? '') + ' · '}
                                    {event.notApplicable ? t('適用 → 不適用', 'Applicable → Not applicable')
                                        : t('不適用 → 適用', 'Not applicable → Applicable')}
                                    {' · ' + event.actor}
                                </li>
                            )}</ul>
                        </details>
                        {canWrite && verified && <>
                            {result.canAssignToSleeves && (unassigned.length ? <form method="post" data-physical-action="assign" class="fields">
                                <input type="hidden" name="definitionId" value={component.id} />
                                <input type="hidden" name="definitionRevision" value={component.physical_revision} />
                                <label>{t('尚未指派的卡套需求', 'Unassigned sleeve requirement')}
                                    <select name="requirementId" required>
                                        <option value="">{t('選擇需求', 'Select a requirement')}</option>
                                        {unassigned.map(row => <option value={row.id} data-revision={row.assignment_revision}>
                                            #{row.id} · {row.width / 10} × {row.height / 10} mm · {row.quantity_sheets} {t('張', 'sleeves')}
                                        </option>)}
                                    </select>
                                </label>
                                <button class="admin-button">{t('關聯需求', 'Assign requirement')}</button>
                            </form> : <p>{t('沒有尚未指派的卡套需求。', 'No unassigned sleeve requirements.')}</p>)}
                        </>}
                    </article>;
                })}
            </section>
            </details>
        </>}
        <D1QuantityPreviewDialog en={en} copies={copies} />
    </div>

<script>
    import '../../lib/physical-component-admin-controller';
</script>

<style>
    .physical-manager { min-width: 0; padding: 16px; background: var(--bg-surface); border-radius: 12px; }
    .fields > label { min-width: 0; max-width: 100%; }
    .fields :is(input, select, textarea) { max-width: 100%; }
    nav, .fields { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; }
    .fields { margin: 12px 0; }
    .fields label { display: grid; gap: 4px; }
    [data-physical-action="create"] :is(input:not([type="checkbox"]), select, button) { min-height: 44px; }
    [data-physical-action="create"] label:has([type="checkbox"]) { min-height: 44px; }
    [data-create-status] { flex-basis: 100%; }
    .fields [data-quantity-reason][hidden], .fields [data-quantity-action][hidden] { display: none; }
    .quantity-notice, .quantity-recovery { flex-basis: 100%; padding: 12px; border-radius: 8px; overflow-wrap: anywhere; }
    .quantity-notice { background: #FFE8E4; color: #B42318; }
    .quantity-recovery { background: #FEF2DD; color: #4A3B33; }
    [data-quantity-action], [data-quantity-submit] { min-height: 44px; }
    [data-quantity-notice][data-tone="success"] { padding: 12px; border-radius: 8px; background: #E8F3E3; color: #2B1914; }
    article, section { border-top: 1px solid #dad8d0; margin-top: 20px; padding-top: 12px; }
    summary { cursor: pointer; }
    .count-controls { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; min-width: 0; }
    .count-controls label { display: grid; gap: 4px; min-width: 0; max-width: 100%; }
    .count-controls :is(button, input, select), [data-component-management] > summary { min-height: 44px; }
    .count-controls :is(input, select) { max-width: 100%; }
    .count-controls input[type="number"] { width: 10ch; }
    [data-count-picker] input[data-count-date]:enabled { border-color: var(--ink-muted); }
    [data-count-picker] input[data-count-date]:focus {
        outline: 3px solid var(--brand-purple);
        outline-offset: 3px;
    }
    .count-controls [hidden] { display: none; }
    [data-count-status] { flex-basis: 100%; margin: 0; }
    /* Count-card thumbnail, sized to the card's three lines (title, info line, controls line).
       Selectors are qualified with [data-count-row] because the global `.admin-page button` padding and
       `.admin-page img { height: auto }` otherwise win over this component's scoped rules. */
    [data-count-row] { display: grid; grid-template-columns: 112px minmax(0, 1fr); column-gap: 16px; align-items: start; }
    [data-count-row] button.component-thumb { width: 112px; height: 112px; min-height: 0; padding: 0; border-radius: 8px;
        display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); place-items: center;
        background: color-mix(in srgb, currentColor 6%, transparent); border: 1px dashed color-mix(in srgb, currentColor 25%, transparent);
        color: color-mix(in srgb, currentColor 55%, transparent); overflow: hidden; }
