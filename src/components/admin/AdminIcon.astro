interface Props {
  name: keyof typeof iconShapes;
  size?: number;
  label?: string;
}

const { name, size = 20, label } = Astro.props;
const accessibleLabel = label?.trim();
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={accessibleLabel ? undefined : 'true'}
  focusable="false"
  role={accessibleLabel ? 'img' : undefined}
>
  {accessibleLabel && <title>{accessibleLabel}</title>}
  <Fragment set:html={iconShapes[name]} />
</svg>
