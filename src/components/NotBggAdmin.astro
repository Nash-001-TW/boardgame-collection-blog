---
import AdminLayout from '../layouts/AdminLayout.astro';
import { adminFieldGroups, accessoryLabels } from '../lib/notbgg-admin-fields';
import { accessoryCategories } from '../lib/notbgg-contract';
interface Props { mode:'list'|'new'|'edit'; id?:string; lang?:'en'|'zh-TW'; }
const {mode,id='',lang='zh-TW'}=Astro.props;
const en=lang==='en',t=(zh:string,english:string)=>en?english:zh,li=en?1:0;
const suffix=en?'?lang=en':'';
---
<AdminLayout lang={lang} title={t('NotBGG 管理','NotBGG administration')}>
<main id="editor-content" class="admin-page" data-notbgg-admin data-mode={mode} data-id={id} data-lang={lang}>
<header><p class="eyebrow">SOMA’S COLLECTION · ADMINISTRATION</p><h1>{t('NotBGG 遊戲管理','NotBGG game management')}</h1><nav aria-label={t('管理導覽','Administration navigation')}>
<a href="/admin">{t('管理首頁','Dashboard')}</a><a href={'/admin/notbgg'+suffix}>{t('遊戲列表','Game list')}</a><a href={'/admin/notbgg/new'+suffix}>{t('新增遊戲','New game')}</a><a href={'?lang='+(en?'zh-TW':'en')}>{en?'繁體中文':'English'}</a></nav></header>
{mode==='edit'&&<p><a href={`/admin/notbgg/${id.slice(7)}/link?lang=${lang}`}>{t('身份對應與主要來源','Identity mapping and primary source')}</a> · <a href={`/admin/notbgg/${id.slice(7)}/relations?lang=${lang}`}>{t('管理專用／相容配件關聯','Manage accessory / compatibility edges')}</a></p>}
<p class="notice">{t('此處管理自建原始資料。封存會保留永久身份與歷史。','Manage original custom game data. Archiving preserves permanent identity and history.')}</p>
<p data-status role="status" aria-live="polite" tabindex="-1"></p><button type="button" data-reload hidden>{t('重新載入最新資料','Reload latest data')}</button>
{mode==='list'?<section aria-label={t('遊戲列表','Game list')}>
<form data-search-form class="toolbar"><label for="query">{t('名稱或完整 NotBGG ID','Name or full NotBGG ID')}<input id="query" name="q" type="search" maxlength="300"/></label><label class="check"><input type="checkbox" name="includeArchived"/>{t('包含已封存','Include archived')}</label><button>{t('查詢','Search')}</button></form>
<div data-list class="records"></div><div class="toolbar"><button type="button" data-prev hidden>{t('上一頁','Previous page')}</button><button type="button" data-next hidden>{t('下一頁','Next page')}</button></div>
</section>:<>
<section class="panel" aria-label={t('系統資料（唯讀）','System information (read only)')}><h2>{t('系統資料','System information')}</h2><dl data-system><div><dt>ID</dt><dd>{t('儲存後自動產生','Assigned after saving')}</dd></div></dl></section>
<form data-editor novalidate>
<fieldset class="panel" disabled><legend>{t('遊戲類型 *','Game type *')}</legend><label for="type">{t('類型','Type')}<select id="type" name="type" required><option value="boardgame">{t('桌遊本體','Base game')}</option><option value="boardgameexpansion">{t('桌遊擴充','Expansion')}</option><option value="boardgameaccessory">{t('桌遊配件','Accessory')}</option></select></label><span id="error-type" class="error" data-error="type"></span></fieldset>
{adminFieldGroups.map(group=><fieldset class="panel" disabled data-group={group.key} hidden={group.key==='accessory'}><legend>{group.label[li]}</legend>
{group.key==='accessory'&&<><p id="category-help">{t('配件子分類 *（至少一項）','Accessory categories * (select at least one)')}</p><div class="checks" role="group" aria-labelledby="category-help">{accessoryCategories.map(category=><label class="check"><input type="checkbox" name="accessoryCategories" aria-describedby="error-accessoryCategories" value={category}/>{accessoryLabels[category][li]}</label>)}</div><span id="error-accessoryCategories" class="error" data-error="accessoryCategories"></span></>}
<div class="fields">{group.fields.map(field=><div class="field"><label for={field.key}>{field.label[li]}</label>
{['list','textarea','refs'].includes(field.kind)?<textarea id={field.key} name={field.key} rows={field.kind==='textarea'?5:3} maxlength={field.max} aria-describedby={'error-'+field.key}/>:<input id={field.key} name={field.key} type={field.kind==='number'?'number':field.kind==='url'?'url':'text'} required={'required' in field&&field.required} min={'min' in field?field.min:undefined} max={field.kind==='number'?field.max:undefined} maxlength={field.kind!=='number'?field.max:undefined} step={field.kind==='number'?'1':undefined} aria-describedby={'error-'+field.key}/>}
<span id={'error-'+field.key} class="error" data-error={field.key}></span></div>)}</div>
</fieldset>)}
<div class="toolbar"><button type="submit" data-save disabled>{t('儲存遊戲','Save game')}</button><button type="button" data-archive hidden>{t('封存遊戲','Archive game')}</button></div>
</form>
<section class="panel" data-history-section hidden><h2>{t('修訂歷史（唯讀）','Revision history (read only)')}</h2><button type="button" data-history-load>{t('讀取修訂歷史','Load history')}</button><div data-history></div><button type="button" data-history-next hidden>{t('更多修訂','More revisions')}</button></section>
</>}
<noscript>{t('此管理介面需要 JavaScript；停用時不會送出資料。','JavaScript is required. No data is submitted when it is disabled.')}</noscript>
</main></AdminLayout>

<script>import { initializeNotBggAdmin } from '../lib/notbgg-admin-controller';document.querySelectorAll<HTMLElement>('[data-notbgg-admin]').forEach(initializeNotBggAdmin);</script>
