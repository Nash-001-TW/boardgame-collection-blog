---
import type { GameDetailModel } from '../lib/games';
import GameCollectionInfo from './GameCollectionInfo.astro';
import GameLiveRelations from './GameLiveRelations.astro';
import GameSignals from './GameSignals.astro';
import AdminCollectionEntry from './AdminCollectionEntry.astro';
import { getCatalogGameType,catalogTypeLabels } from '../lib/game-content';
import { translateGameName,translateBggCategory,translateBggMechanic,translateBggComplexity,useTranslations } from '../i18n/utils';
import { decodeGameName } from '../lib/game-name';
import { descriptionParagraphs,positiveNumber,numberRange,rankLabel } from '../lib/game-detail-presentation';
import { validGameComplexity } from '../lib/game-complexity';
interface Props {game:GameDetailModel;lang:'en'|'zh-TW';}
const {game,lang}=Astro.props,b=game.bgg,zh=lang==='zh-TW',t=useTranslations(lang);
const name=translateGameName(game.bggId,b.name,lang),original=decodeGameName(b.name),cover=b.image||b.thumbnail;
const paragraphs=descriptionParagraphs(b.description),long=paragraphs.join('\n\n').length>550;
const weight=validGameComplexity(b.averageWeight);
const metadata=[{label:t('info.designer'),items:(b.designers??[]).map(i=>decodeGameName(i.name))},{label:t('info.artist'),items:(b.artists??[]).map(i=>decodeGameName(i.name))},{label:t('info.publisher'),items:(b.publishers??[]).map(i=>decodeGameName(i.name))},{label:t('info.category'),items:(b.categories??[]).map(i=>translateBggCategory(i,lang))},{label:t('info.mechanic'),items:(b.mechanics??[]).map(i=>translateBggMechanic(i,lang))},{label:t('info.family'),items:(b.families??[]).map(i=>decodeGameName(i.name))}].filter(row=>row.items.length);
const basic=[{label:t('game.players'),value:numberRange(b.minPlayers,b.maxPlayers)},{label:t('game.bestPlayers'),value:b.bestPlayerCounts?.length?b.bestPlayerCounts.join(' / '):'—'},{label:t('game.playTime'),value:numberRange(b.minPlayTime,b.maxPlayTime)+(b.maxPlayTime>0?(zh?' 分鐘':' min'):'')},{label:t('game.age'),value:b.minAge?`${b.minAge}+`:'—'},{label:t('game.complexity'),value:weight!==null?`${positiveNumber(weight,2)} / 5`:'—',hint:weight!==null?translateBggComplexity(b.complexity,lang):undefined}];
const ratings=[{label:t('bgg.averageRating'),value:positiveNumber(b.averageRating,2)},{label:t('bgg.bggRating'),value:positiveNumber(b.bggRating,2)},{label:t('bgg.usersRated'),value:positiveNumber(b.usersRated)},{label:t('bgg.overallRank'),value:b.overallRank&&b.overallRank>0?`#${positiveNumber(b.overallRank)}`:'—'}];
---
<main class="detail-v2" data-detail-v2>
<a class="back-link" href={zh?'/games':'/en/games'} data-detail-back>← {t('game.backToGames')}</a>
<p><AdminCollectionEntry gameKey={'BGG:'+game.bggId} lang={lang}/></p>
<section class="detail-hero panel">
<div class="cover-column">{cover?<button type="button" class="cover-button" data-cover-open data-cover-error-label={zh?'圖片無法載入':'Image unavailable'} aria-label={zh?'放大遊戲封面':'Enlarge game cover'} aria-haspopup="dialog"><img src={cover} alt={name} fetchpriority="high" decoding="async"/><span>{zh?'點擊放大':'Enlarge cover'} ⤢</span></button>:<div class="no-cover">{zh?'暫無封面':'No cover available'}</div>}</div>
<div class="hero-copy"><p class="eyebrow">{catalogTypeLabels[getCatalogGameType(b.gameType)][zh?0:1]} <span>· {b.year>0?b.year:'—'}</span></p>
<h1>{name}</h1>{name!==original&&<p class="original-name">{original}</p>}
<div class="quick-stats">{basic.map(item=><div><span>{item.label}</span><strong>{item.value}</strong>{item.hint&&<small>{item.hint}</small>}</div>)}</div>
<div class="ratings"><h2>{t('bgg.ratings')}</h2><div class="rating-stats">{ratings.map(item=><div><span>{item.label}</span><strong>{item.value}</strong></div>)}</div>
{b.categoryRanks?.length>0&&<ul class="rank-list">{b.categoryRanks.map(r=><li>{rankLabel(r,lang)} <strong>{r.rank&&r.rank>0?`#${positiveNumber(r.rank)}`:'—'}</strong></li>)}</ul>}</div>
<GameSignals game={b} lang={lang} compact />
</div></section>
<nav class="section-nav" aria-label={zh?'詳細頁區塊':'Detail sections'}><a href="#game-info">{zh?'遊戲資訊':'Game information'}</a><a href="#game-collection">{zh?'收藏資訊':'My collection'}</a><a href="#game-sleeves">{zh?'牌套需求':'Card sleeves'}</a><a href="#game-relations">{zh?'遊戲關聯':'Relations'}</a></nav>
<div class="detail-columns">
<div class="detail-column">
<section class="panel description" id="game-info"><h2>{t('game.description')}</h2>
{paragraphs.length?long?<><p class="description-preview">{paragraphs.join('\n\n').slice(0,420)}…</p><details data-description><summary><span class="more-label">{zh?'顯示更多':'Show more'}</span><span class="less-label">{zh?'收合':'Show less'}</span></summary><div class="description-body">{paragraphs.map(p=><p>{p}</p>)}</div></details></>:<div class="description-body">{paragraphs.map(p=><p>{p}</p>)}</div>:<p class="muted">{zh?'目前沒有遊戲介紹。':'No description available.'}</p>}
</section>
<section class="panel"><h2>{t('info.title')}</h2><dl class="metadata">{metadata.map(row=><div><dt>{row.label}</dt><dd>{row.items.map(item=><span class="tag">{item}</span>)}</dd></div>)}</dl>{!metadata.length&&<p class="muted">{zh?'目前尚無其他資料。':'No further metadata available.'}</p>}</section>
<GameCollectionInfo gameKey={'BGG:'+game.bggId} lang={lang}/>
</div>
<div class="detail-column"><div id="game-relations"><GameLiveRelations gameKey={'BGG:'+game.bggId} lang={lang}/></div>
<section class="panel related-links"><h2>{zh?'相關連結':'Related links'}</h2><a class="primary-link" href={`https://boardgamegeek.com/boardgame/${game.bggId}`} target="_blank" rel="noopener noreferrer">{zh?'查看 BGG 原始資料':'View on BoardGameGeek'} <span aria-hidden="true">↗</span><span class="sr-only">{zh?'（另開新分頁）':' (opens in a new tab)'}</span></a><a href={zh?'/collection':'/en/collection'}>{zh?'前往個人收藏模組':'Open My Collection'} →</a><p class="muted">{zh?'個人評價、購買及牌套紀錄請至收藏模組管理；此處不代表已收藏。':'Manage personal ratings, purchases and sleeves in My Collection. This page does not imply ownership.'}</p></section></div>
</div>
{cover&&<dialog class="cover-dialog" data-cover-dialog aria-labelledby="cover-dialog-title"><div class="dialog-toolbar"><h2 id="cover-dialog-title">{name}</h2><button type="button" data-cover-close autofocus aria-label={zh?'關閉封面':'Close cover'}>✕</button></div><img data-dialog-cover data-src={cover} alt={name} decoding="async"/></dialog>}
</main>
<style>
.detail-v2{max-width:1280px;margin:auto;padding:0;color:#293c4e}.back-link{display:inline-block;margin:0 0 16px;color:#48627a;text-decoration:none;font-size:.88rem}.panel{background:#fff;border:1px solid #e3e4e4;border-radius:14px;padding:22px;min-width:0;box-shadow:0 2px 8px #253d4c03}.detail-hero{display:grid;grid-template-columns:minmax(170px,245px) minmax(0,1fr);gap:28px;align-items:start}.cover-button{display:block;width:100%;border:0;background:transparent;padding:0;cursor:zoom-in;color:#607285;font:inherit}.cover-button{position:relative;aspect-ratio:3/4;margin-bottom:24px}.cover-button img{display:block;width:100%;height:100%;position:absolute;inset:0;object-fit:contain;border-radius:9px}.cover-button span{position:absolute;top:100%;width:100%;display:block;font-size:.74rem;margin-top:8px}.no-cover{aspect-ratio:3/4;background:#f0f2f4;display:grid;place-items:center;border-radius:9px;color:#718093}.eyebrow{font-size:.8rem;color:#3d607f;margin:0 0 7px}.eyebrow span{color:#78838d}h1{font-size:clamp(1.35rem,2.6vw,2rem);line-height:1.3;margin:0;overflow-wrap:anywhere}.original-name{font-size:.85rem;color:#75808d;margin:6px 0}.quick-stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin:20px 0}.quick-stats>div,.rating-stats>div{padding:12px 10px;background:#f5f7f9;border-radius:9px;min-width:0}.quick-stats span,.rating-stats span{display:block;font-size:.72rem;color:#687887;margin-bottom:7px}.quick-stats strong{font-size:.9rem;overflow-wrap:anywhere}.quick-stats small{display:block;color:#6b7c8a;font-size:.7rem;margin-top:5px}h2{font-size:1.1rem;margin:0 0 14px}.ratings h2{font-size:.85rem;margin-bottom:9px}.rating-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.rating-stats strong{font-size:1.3rem;font-variant-numeric:tabular-nums;color:#234e74}.rank-list{list-style:none;padding:0;margin:12px 0 0;display:flex;gap:8px;flex-wrap:wrap}.rank-list li{font-size:.75rem;border:1px solid #e1e7ec;padding:6px 9px;border-radius:7px}.rank-list strong{margin-left:8px;color:#244e73}.section-nav{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}.section-nav a{display:inline-flex;align-items:center;min-height:44px;box-sizing:border-box;border:1px solid #d6dfe6;background:#fff;padding:9px 14px;border-radius:8px;font-size:.82rem;text-decoration:none;color:#244e73}.section-nav a:hover{background:#eef4f9;border-color:#8fb0c9}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.detail-columns{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,1fr);gap:18px;align-items:start}.detail-column{display:grid;gap:18px;min-width:0}.description-body p,.description-preview{font-size:.88rem;line-height:1.85;white-space:pre-line;margin:0 0 12px;overflow-wrap:anywhere}.description details summary{cursor:pointer;color:#244e73;font-size:.85rem;padding:8px 0}.less-label{display:none}.description:has(details[open]) .description-preview{display:none}details[open] .more-label{display:none}details[open] .less-label{display:inline}.description-body{margin-top:10px}.metadata{margin:0}.metadata>div{display:grid;grid-template-columns:80px minmax(0,1fr);gap:12px;padding:11px 0;border-bottom:1px solid #edf0f3}.metadata>div:last-child{border:0;padding-bottom:0}dt{font-size:.8rem;color:#697b8b;padding-top:5px}dd{display:flex;flex-wrap:wrap;gap:5px;margin:0;min-width:0}.tag{font-size:.76rem;line-height:1.45;background:#f1f4f7;border-radius:5px;padding:5px 7px;overflow-wrap:anywhere}.muted{font-size:.82rem;color:#71808e;line-height:1.7}.related-links>a{display:block;color:#244e73;padding:10px 0;font-size:.86rem}.related-links .primary-link{background:#244e73;color:white;text-decoration:none;border-radius:8px;padding:12px 14px}.cover-dialog{border:0;border-radius:12px;padding:18px;max-width:92vw;max-height:92vh;width:fit-content;background:#fff}.cover-dialog::backdrop{background:#172a3dda}.dialog-toolbar{display:flex;align-items:center;gap:16px;justify-content:space-between}.dialog-toolbar h2{font-size:.9rem;max-width:70vw}.dialog-toolbar button{min-width:44px;min-height:44px;border:1px solid #d0d9e2;border-radius:8px;padding:10px;background:white;cursor:pointer}.cover-dialog img{display:block;max-width:85vw;max-height:74vh;width:auto;height:auto;object-fit:contain;margin:auto}a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #427ba5;outline-offset:3px}
@media(max-width:900px){.quick-stats{grid-template-columns:repeat(3,minmax(0,1fr))}.detail-hero{grid-template-columns:190px minmax(0,1fr);gap:20px}}@media(max-width:680px){.detail-hero,.detail-columns{grid-template-columns:1fr}.cover-column{width:min(100%,240px);margin:auto}.panel{padding:17px}.quick-stats{grid-template-columns:repeat(2,minmax(0,1fr));margin:16px 0}.rating-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.metadata>div{grid-template-columns:65px minmax(0,1fr);gap:8px}.detail-columns,.detail-column{gap:14px}}
</style>
<script>
import { initializeGameDetail } from '../lib/game-detail-controller';
function initialize() { document.querySelectorAll<HTMLElement>('[data-detail-v2]').forEach(initializeGameDetail); }
initialize(); document.addEventListener('astro:page-load', initialize);
</script>
