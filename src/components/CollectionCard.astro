---
import type { CollectionV2Game } from "../lib/collection-v2-adapter";
import type { Language } from "../i18n/ui";
import { getCollectionV2GameUrl } from "../lib/collection-v2-links";

interface Props {
    game: CollectionV2Game;
    lang?: Language;
}

const { game, lang = "zh-TW" } = Astro.props;
const zh = lang === "zh-TW";
const bgg = game.bgg;
const displayName = game.displayName;
const originalName = bgg?.name ?? game.primaryName ?? "";
const gameUrl = getCollectionV2GameUrl(game.bggId, lang);
const mechanics = bgg?.mechanics ?? [];
const categories = bgg?.categories ?? [];

const typeNames: Record<string, [string, string]> = {
    base: ["主遊戲", "Base Game"],
    bundle: ["組合包", "Bundle"],
    expansion: ["擴充", "Expansion"],
    promo: ["宣傳品", "Promo"]
};
const typeName = typeNames[game.itemType]?.[zh ? 0 : 1] ?? game.itemType;
const labels = zh ? {
    noImage: "暫無遊戲圖片", players: "人", minutes: "分",
    owned: "已收藏", wishlist: "願望清單", preorder: "預購",
    rating: "我的評分", playCount: "遊玩次數",
    price: "購入價格", source: "購入來源"
} : {
    noImage: "No image available", players: "players", minutes: "min",
    owned: "Owned", wishlist: "Wishlist", preorder: "Preordered",
    rating: "My Rating", playCount: "Plays",
    price: "Purchase Price", source: "Purchase Source"
};
---

<article
    class="game-card"
    data-game-card
    data-collection-id={game.collectionId}
    data-item-type={game.itemType}
    data-name={displayName}
    data-original-name={originalName}
    data-bgg-id={game.bggId ?? ""}
    data-year={bgg?.year ?? ""}
    data-rating=""
    data-bgg-rating={bgg?.averageRating ?? ""}
    data-weight={bgg?.averageWeight ?? ""}
    data-owned={String(game.owned)}
    data-wishlist={String(game.wishlist)}
    data-preorder={String(game.preordered)}
    data-want-to-play="false"
    data-want-to-buy="false"
    data-expansion={String(game.itemType === "expansion")}
    data-min-players={bgg?.minPlayers ?? ""}
    data-max-players={bgg?.maxPlayers ?? ""}
    data-max-time={bgg?.maxPlayTime ?? ""}
    data-mechanics={mechanics.map(m => m.id).join(",")}
    data-mechanic-names={mechanics.map(m => m.name.replaceAll("|", " ")).join("|")}
    data-categories={categories.map(c => c.id).join(",")}
    data-category-names={categories.map(c => c.name.replaceAll("|", " ")).join("|")}
>
    {gameUrl ? (
        <a class="cover-link" href={gameUrl}>
            {bgg?.image ? (
                <img class="game-cover" src={bgg.image} alt={displayName} loading="lazy" decoding="async" />
            ) : (
                <div class="cover-placeholder"><span class="placeholder-icon">🎲</span><small>{labels.noImage}</small></div>
            )}
        </a>
    ) : (
        <div class="cover-link">
            {bgg?.image ? (
                <img class="game-cover" src={bgg.image} alt={displayName} loading="lazy" decoding="async" />
            ) : (
                <div class="cover-placeholder"><span class="placeholder-icon">🎲</span><small>{labels.noImage}</small></div>
            )}
        </div>
    )}

    <div class="game-info">
        <div class="title-row">
            <div>
                <h2>{gameUrl ? <a href={gameUrl}>{displayName}</a> : <span>{displayName}</span>}</h2>
                {bgg?.year != null && <p class="year">{bgg.year}</p>}
            </div>
        </div>

        <div class="game-meta">
            {bgg?.minPlayers != null && bgg?.maxPlayers != null && (
                <span>👥 {bgg.minPlayers}–{bgg.maxPlayers} {labels.players}</span>
            )}
            {bgg?.minPlayTime != null && bgg?.maxPlayTime != null && (
                <span>🕐 {bgg.minPlayTime}–{bgg.maxPlayTime} {labels.minutes}</span>
            )}
        </div>

        <div class="badges">
            <span class="badge type">{typeName}</span>
            {game.owned && <span class="badge owned">✓ {labels.owned}</span>}
            {game.wishlist && <span class="badge wishlist">♡ {labels.wishlist}</span>}
            {game.preordered && <span class="badge preorder">⏳ {labels.preorder}</span>}
        </div>

        <div class="collection-details">
            <div class="detail-item"><small>{labels.rating}</small><strong>—</strong></div>
            <div class="detail-item"><small>{labels.playCount}</small><strong>—</strong></div>
            <div class="detail-item"><small>{labels.price}</small><strong>—</strong></div>
            <div class="detail-item"><small>{labels.source}</small><strong>—</strong></div>
        </div>
    </div>
</article>

<style>

    /* ========================================================
       Card
       ======================================================== */

    .game-card {
        background: white;
        border: 1px solid #ddd;
        border-radius: 12px;
        overflow: hidden;

        display: inline-block;
        width: 100%;
        vertical-align: top;
        break-inside: avoid;
        -webkit-column-break-inside: avoid;
        margin: 0 0 18px;
        background: #fffdf8;
        border-color: #e9d9c2;
        box-shadow: 0 3px 12px rgba(89, 65, 42, 0.07);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .game-card:hover {
        transform: translateY(-3px);

        box-shadow:
            0 6px 18px rgba(0, 0, 0, 0.10);
    }

    /*
     * CollectionFilter 會加入 / 移除 hidden class
     */
    .game-card.hidden {
        display: none;
    }

    /* ========================================================
       Cover
       ======================================================== */

    .cover-link {
        display: block;
        text-decoration: none;
    }

    .game-cover,
    .cover-placeholder {
        width: 100%;
        height: auto;
    }

    .game-cover {
        display: block;
        object-fit: contain;
        max-height: 420px;
        background: #f8f1e6;
    }

    .cover-placeholder {
        min-height: 210px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 8px;
        background: #f2f2f2;
        color: #777;
    }

    .placeholder-icon {
        font-size: 48px;
    }

    /* ========================================================
       Game Information
       ======================================================== */

    .game-info {
        padding: 16px;
    }

    .title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
    }

    .title-row h2 {
        margin: 0;
        font-size: 18px;
        line-height: 1.4;
    }

    .title-row h2 a,
    .title-row h2 span {
        color: #4e3828;
        text-decoration: none;
    }

    .title-row h2 a:hover {
        text-decoration: underline;
    }

    .year {
        margin: 5px 0 0;
        color: #777;
        font-size: 14px;
    }

    .rating {
        display: flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
    }

    /* ========================================================
       Game Meta
       ======================================================== */

    .game-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 14px;
        font-size: 14px;
    }

    .language {
        margin: 12px 0 0;
        color: #666;
        font-size: 14px;
    }

    /* ========================================================
       Badges
       ======================================================== */

    .badges {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 14px 0;
    }

    .badge {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        background: #f5ebdd;
        font-size: 12px;
    }

    .badge.type { background: #eaf4ff; color: #245d91; }

    .badge.owned {
        background: #e8f8ec;
    }

    .badge.wishlist {
        background: #fff1f5;
    }

    .badge.preorder {
        background: #fff6df;
    }

    .badge.condition {
        background: #eef2ff;
    }

    .badge.sleeves {
        background: #eef8ff;
    }

    /* ========================================================
       Collection Details
       ======================================================== */

    .collection-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        border-top: 1px solid #eadfce;
        padding-top: 14px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .detail-item small {
        color: #777;
    }

    .detail-item strong {
        font-size: 14px;
    }

    /* ========================================================
       Extra Information
       ======================================================== */

    .extra-info {
        margin-top: 16px;
        padding-top: 12px;
        border-top: 1px solid #eadfce;
        font-size: 13px;
        color: #555;
    }

    .extra-info p {
        margin: 5px 0;
    }

    @media (prefers-reduced-motion: reduce) {
        .game-card { transition: none; }
        .game-card:hover { transform: none; }
    }

</style>
