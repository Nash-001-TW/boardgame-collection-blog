---
import AdminLayout from '../layouts/AdminLayout.astro';
interface Props {id:string;lang?:'zh-TW'|'en'}
const {id,lang='zh-TW'}=Astro.props,en=lang==='en',t=(zh:string,english:string)=>en?english:zh;
---
<AdminLayout lang={lang} title={t('NotBGG 管理','NotBGG administration')}>
<main id="editor-content" class="admin-page" data-link-admin data-id={id} data-lang={lang}><h1>{t('NotBGG 身份對應','NotBGG identity mapping')}</h1><nav><a href={`/admin/notbgg/${id.slice(7)}?lang=${lang}`}>{t('原始遊戲資料','Original game')}</a> · <a href="/admin">{t('管理首頁','Dashboard')}</a></nav>
<p>{id} · {t('候選不代表確認；確認後仍保留原稿、收藏與副本。','A candidate is not confirmation. Original data, collection records and copies remain intact.')}</p>
<p data-link-status role="status" aria-live="polite" tabindex="-1"></p><p data-link-state></p><button type="button" data-link-reload>{t('載入最新狀態與目前候選','Load latest state and current candidate')}</button>
<form data-compare-form><label>{t('候選 BGG 正整數 ID','Candidate BGG positive integer ID')}<input name="bggId" type="number" min="1" step="1" required/></label><button>{t('查詢與比較','Look up and compare')}</button></form>
<div data-link-comparison class="comparison"></div>
<label>{t('本次操作原因（必填）','Reason for this operation (required)')}<textarea name="reason" maxlength="3000" required/></label>
<div class="actions"><button type="button" data-command="propose">{t('建立候選','Propose candidate')}</button><button type="button" data-command="confirm">{t('人工確認同一身份','Confirm same identity')}</button><button type="button" data-command="notbgg">{t('切換為 NotBGG 主要來源','Use NotBGG primary')}</button><button type="button" data-command="bgg">{t('切換為 BGG 主要來源','Use BGG primary')}</button><button type="button" data-command="revoke">{t('解除／取消對應（保留歷史）','Revoke mapping / candidate (retain history)')}</button></div>
<h2>{t('對應操作歷史','Mapping history')}</h2><ol data-link-history></ol><button type="button" data-history-more>{t('載入更多歷史','Load more history')}</button></main>
<script>import {initializeNotBggLinkAdmin} from '../lib/notbgg-link-controller';document.querySelectorAll<HTMLElement>('[data-link-admin]').forEach(initializeNotBggLinkAdmin);</script>
</AdminLayout>
