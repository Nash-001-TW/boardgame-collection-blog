---
import type { Game } from "../lib/games";
import type { Language } from "../i18n/ui";
import CatalogBrowserControls from "./CatalogBrowserControls.astro";
import CatalogCard from "./CatalogCard.astro";
import { buildCatalogPayload } from "../lib/catalog-payload";
import { readCatalogUrl,selectCatalogEntries } from '../lib/catalog-selection';
interface Props { games: Game[]; lang: Language; payload?: ReturnType<typeof buildCatalogPayload>; live?:boolean; }
const { games, lang } = Astro.props;
const zh = lang === "zh-TW";
const payload = Astro.props.payload ?? buildCatalogPayload(games, lang);
const initialState=readCatalogUrl(Astro.url,payload.mechanics);
const matched = selectCatalogEntries(payload.records,initialState,lang);
const initial = matched.slice(0,Math.min(initialState.page,Math.ceil(payload.records.length/24))*24);
// JSON is inert data; escaping < prevents a source name from closing the script element.
const serialized = JSON.stringify(payload).replaceAll("<", "\\u003c");
const blank = { dataset:{name:""}, href:"",image:"",fallback:"",expansions:0,typeLabel:"",players:"",time:"",rating:"",signals:[] };
---
<section class="game-browser" data-game-browser data-live-catalog={Astro.props.live ? "true" : undefined} data-browser-module="games" data-loading-mode="progressive" data-view={initialState.view} data-locale={lang}>
    <CatalogBrowserControls lang={lang} initialCount={matched.length} />
    <script type="application/json" data-catalog-payload set:html={serialized} />
    <template data-catalog-card-template><CatalogCard record={blank} lang={lang} /></template>
    <div class="game-grid" data-game-grid>
        {initial.map((record,index)=><CatalogCard record={record} lang={lang} index={index} />)}
    </div>
    <nav data-game-pagination hidden aria-label={zh ? "分批載入" : "Batch navigation"}></nav>
    <div class="load-area">
        <p data-load-status role="status" aria-live="polite"></p>
        <button type="button" data-load-more>{zh ? "載入更多" : "Load more"}</button>
        <div data-load-sentinel aria-hidden="true"></div>
    </div>
    <button type="button" class="back-to-top" data-back-to-top hidden aria-label={zh ? "回到頂部" : "Back to top"}>↑ <span>{zh ? "頂部" : "Top"}</span></button>
    <noscript>
        <p>{zh ? "啟用 JavaScript 可搜尋、篩選及分批載入；也可使用以下完整目錄連結。" : "Enable JavaScript for search, filters and batches, or browse all catalog links below."}</p>
        <details><summary>{zh ? "完整遊戲目錄" : "Complete game catalog"}</summary><ul>{payload.records.map(r=><li>{r.href?<a href={r.href}>{r.dataset.name}</a>:r.dataset.name}</li>)}</ul></details>
    </noscript>
</section>
<style is:global>
    .game-browser[data-browser-module="games"] { width:100%; color:#303b46; }
     .game-browser[data-browser-module="games"] .game-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); grid-auto-rows:auto; gap:12px; align-items:start; }
     .game-browser[data-browser-module="games"] .game-card{ min-width:0; align-self:start; background:#fff; border:1px solid #e0e6eb; border-radius:12px; overflow:hidden; box-shadow:0 1px 4px #21394b05; }
     .game-browser[data-browser-module="games"] .game-link{ display:block; color:inherit; text-decoration:none; }
     .game-browser[data-browser-module="games"] a.game-link:hover{ background:#f7fafc; }  .game-browser[data-browser-module="games"] a.game-link:focus-visible{ outline:3px solid #2870a8; outline-offset:-3px; }
     .game-browser[data-browser-module="games"] .cover-shell{ position:relative; width:100%; aspect-ratio:3/4; background:#f0f3f5; }
     .game-browser[data-browser-module="games"] .cover-placeholder{ display:grid; place-items:center; aspect-ratio:3/4; width:100%; padding:16px; color:#64717b; font-size:.85rem; }
     .game-browser[data-browser-module="games"] .cover-shell img{ display:block; width:100%; height:100%; position:absolute; inset:0; object-fit:contain; vertical-align:middle; }
     .game-browser[data-browser-module="games"] .cover-shell[data-image-present="true"] .cover-placeholder{ display:none; }
     .game-browser[data-browser-module="games"] .cover-shell[data-image-loaded="true"] img{ aspect-ratio:auto; }
     .game-browser[data-browser-module="games"] .cover-shell[data-image-loaded="true"] .cover-placeholder{ display:none; }
     .game-browser[data-browser-module="games"] .card-copy{ padding:8px 10px; }  .game-browser[data-browser-module="games"] h2{ font-size:.95rem; line-height:1.5; margin:0; overflow-wrap:anywhere; }
     .game-browser[data-browser-module="games"] .expansion-count{ display:inline-block; margin-top:5px; padding:2px 6px; border:1px solid #cfdfeb; border-radius:6px; font-size:.72rem; color:#305879; background:#eef5fb; }
     .game-browser[data-browser-module="games"] .list-only{ display:none; }  .game-browser[data-browser-module="games"] .game-facts{ display:flex; gap:10px 22px; flex-wrap:wrap; margin:10px 0; font-size:.85rem; }
     .game-browser[data-browser-module="games"] .game-facts div{ display:flex; gap:6px; }  .game-browser[data-browser-module="games"] dt{ color:#667580; }  .game-browser[data-browser-module="games"] dd{ margin:0; font-weight:600; }  .game-browser[data-browser-module="games"] .game-type{ font-size:.8rem; color:#667580; }
    .game-browser[data-browser-module="games"][data-view="list"] .game-grid { grid-template-columns:minmax(0,1fr); grid-auto-rows:auto; gap:12px; }
    .game-browser[data-browser-module="games"][data-view="list"] .game-link { display:grid; grid-template-columns:96px minmax(0,1fr); }
    .game-browser[data-browser-module="games"][data-view="list"] .cover-shell { align-self:start; }
    .game-browser[data-browser-module="games"][data-view="list"] .card-copy { padding:14px 18px; }
    .game-browser[data-browser-module="games"][data-view="list"] .list-only { display:block; }
    
     .game-browser[data-browser-module="games"] .load-area{ padding:30px 0; text-align:center; color:#64717b; }  .game-browser[data-browser-module="games"] .load-area button{ padding:11px 24px; border:1px solid #ccd7df; background:#fff; color:#234d71; border-radius:10px; cursor:pointer; }
     .game-browser[data-browser-module="games"] .load-area button:disabled{ opacity:.5; cursor:default; }  .game-browser[data-browser-module="games"] [data-load-sentinel]{ height:1px; }
     .game-browser[data-browser-module="games"] .back-to-top{ position:fixed; bottom:22px; right:22px; z-index:25; min-width:44px; min-height:44px; padding:10px 14px; color:#fff; background:#234d71; border:0; border-radius:12px; box-shadow:0 4px 15px #102c4b30; cursor:pointer; }
     .game-browser[data-browser-module="games"] [hidden]{ display:none !important; }
    @media(max-width:600px) {  .game-browser[data-browser-module="games"] .game-grid{ grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }  .game-browser[data-browser-module="games"] .card-copy{ padding:8px; }  .game-browser[data-browser-module="games"] h2{ font-size:.85rem; }  .game-browser[data-browser-module="games"] .back-to-top{ right:12px; bottom:12px; } }
    @media(max-width:380px) { .game-browser[data-browser-module="games"][data-view="list"] .game-link { grid-template-columns:70px minmax(0,1fr); } .game-browser[data-browser-module="games"][data-view="list"] .card-copy { padding:10px; }  .game-browser[data-browser-module="games"] .game-facts{ gap:6px 10px; font-size:.78rem; } }
    @media(prefers-reduced-motion:reduce) {  .game-browser[data-browser-module="games"] *{ scroll-behavior:auto; } }

.game-browser[data-browser-module="games"] .catalog-signals {list-style:none;display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:10px 0;}
.game-browser[data-browser-module="games"] .catalog-signals li {padding:5px 8px;border:1px solid #d8c7ac;border-radius:8px;background:#fff8eb;font-size:.8rem;overflow-wrap:anywhere;}
</style>
<script>
    import { initializeGameListController } from "../lib/game-list-controller";
    function initialize() {
        document.querySelectorAll<HTMLElement>('[data-browser-module="games"]').forEach(root => initializeGameListController({root,pageSize:24,debounceMs:250}));
    }
    initialize(); document.addEventListener("astro:page-load", initialize);
</script>
