---
import Header from "../components/Header.astro";

const {
    title = "Nash's Board Game Blog"
} = Astro.props;
---

<html lang="zh-TW">

    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width"
        />

        <title>{title}</title>
    </head>

    <body>

        <Header />

        <main>
            <slot />
        </main>

        <footer>
            <p>© 2026 Soma's Board Game Collection Blog</p>
        </footer>

    </body>

</html>

<style is:global>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, "Microsoft JhengHei", sans-serif;
        background-color: #f5f5f5;
        color: #333;
    }

    main {
        max-width: 1100px;
        margin: auto;
        padding: 30px 20px;
    }

    footer {
        text-align: center;
        padding: 30px;
        color: #777;
    }

</style>