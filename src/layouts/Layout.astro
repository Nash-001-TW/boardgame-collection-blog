---
import Header from "../components/Header.astro";
import type { Language } from "../i18n/ui";
import "../styles/cat-adventure-theme.css";

interface Props {
    canonical?: string;
    description?: string;
    image?: string;
    noindex?: boolean;
    title: string;
    lang?: Language;
    catalogPage?: boolean;
    detailPage?: boolean;
}

const { title, lang = "zh-TW", catalogPage = false, detailPage = false } = Astro.props;
const isZh = lang === "zh-TW";
const canonical=Astro.props.canonical??new URL(Astro.url.pathname,Astro.url.origin).href;
const description=Astro.props.description??(isZh?'Soma 的桌遊收藏、遊戲資訊與心得分享。':"Soma's board game collection, game information and stories.");
---
<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#fbf5e9" />
        <title>{title}</title>
        <meta name="description" content={description}/>
        <link rel="canonical" href={canonical}/>
        <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={detailPage?'article':'website'}/>
        {Astro.props.image&&<meta property="og:image" content={Astro.props.image}/>}
        {Astro.props.noindex&&<meta name="robots" content="noindex,nofollow"/>}
    </head>
    <body class:list={{ "catalog-layout": catalogPage, "detail-layout": detailPage }}>
        <a class="public-skip" href="#content">{isZh?'跳至主要內容':'Skip to content'}</a>
        <div class="site-shell">
            <Header lang={lang} />
            <!-- 全站主題橫幅：四貓插圖已完成，取代原本的文字版暫代橫幅（2026-11-23 使用者選定）。
                 width／height 為原圖實際尺寸，讓瀏覽器預先保留比例避免版面跳動；位於首屏故優先載入。 -->
            {!catalogPage && (
            <div class="adventure-banner">
                <img
                    src="/images/cat-adventure-banner.png"
                    alt="Soma's Board Game Collection 四貓冒險者"
                    width="2172"
                    height="724"
                    fetchpriority="high"
                    decoding="async"
                />
            </div>
            )}

            <!-- 使用 div 而不是 main，避免詳細頁元件內的 main 重複巢狀 -->
            <div class="site-content" id="content">
                <slot />
            </div>

            <footer class="site-footer">
                <p>© 2026 Soma's Board Game Collection Blog</p>
                <p class="footer-subtitle">{isZh ? "一起收藏更多好遊戲！" : "Collect more great games together!"} 🐾</p>
            </footer>
        </div>
    </body>
</html>

<style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
        margin: 0;
        min-width: 0;
        font-family: "Microsoft JhengHei", "Noto Sans TC", Arial, sans-serif;
        background: #fbf5e9;
        color: #392b27;
    }
    .site-shell { min-height: 100vh; display: flex; flex-direction: column; }
    .public-skip{position:absolute;left:12px;top:-80px;z-index:100;background:#fff;padding:12px;color:#244e73}.public-skip:focus{top:10px}
    body.catalog-layout { background:#f7f9fb; color:#303b46; }
    .catalog-layout .site-content { max-width:1440px; margin:0 auto; padding:28px clamp(16px,3vw,42px) 48px; }
    body.detail-layout { background:#f6f4ef; min-width:0; }
    .detail-layout .site-content { max-width:1360px; padding:24px clamp(16px,3vw,40px) 30px; }
    .detail-layout .site-footer { padding:18px 16px; }
    .site-content { width: 100%; flex: 1; min-width: 0; }
    .site-footer {
        padding: 28px 16px;
        text-align: center;
        color: #796657;
        background: #f2e5d2;
        border-top: 1px solid #dfcbb0;
    }
    .site-footer p { margin: 4px 0; }
    .footer-subtitle { font-size: 13px; }
    /* 四貓冒險主題橫幅：合併原本兩組重複規則，保留合併前實際生效的外觀（底色與下框線） */
    .adventure-banner {
        width: 100%;
        overflow: hidden;
        background: #f8eddc;
        border-bottom: 3px solid #c6a781;
    }

    /* width:100% + height:auto 依 HTML 的 width/height 比例縮放，各螢幕寬度皆適用 */
    .adventure-banner img {
        display: block;
        width: 100%;
        height: auto;
        object-fit: contain;
    }
</style>
