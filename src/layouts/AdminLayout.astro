---
import '../styles/admin-theme.css';
import '../styles/admin-editor.css';
import '../styles/admin-ui.css';
import AdminIcon from '../components/admin/AdminIcon.astro';
import { adminNavigation, adminNavigationHref, currentAdminItem } from '../lib/admin-shell-controller';

interface Props { lang?: 'zh-TW' | 'en'; title: string; languageParams?: Record<string, string> }
const { lang = 'zh-TW', title, languageParams } = Astro.props;
const en = lang === 'en';
const alternateLang = en ? 'zh-TW' : 'en';
const languageParamsWithCurrent = new URLSearchParams(languageParams);
for (const key of Astro.url.searchParams.keys()) languageParamsWithCurrent.delete(key);
Astro.url.searchParams.forEach((value, key) => languageParamsWithCurrent.append(key, value));
languageParamsWithCurrent.set('lang', alternateLang);
const languageHref = '?' + languageParamsWithCurrent;
const current = currentAdminItem(Astro.url);
const brand = en ? 'Board Game Collection' : '桌遊收藏管理系統';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>{title} | Soma’s Administration</title>
  </head>
  <body class="admin-app">
    <a class="admin-skip" href="#editor-content">{en ? 'Skip to content' : '跳至內容'}</a>
    <header class="shell-app-bar">
      <button type="button" data-shell-open aria-controls="admin-drawer" aria-expanded="false"
        aria-label={en ? 'Open navigation' : '開啟導覽'}><AdminIcon name="menu" /></button>
      <span>{brand}</span>
    </header>
    <div class="shell-workspace">
      <aside class="shell-sidebar" data-shell-sidebar>
        <div class="shell-brand">
          <span class="shell-paw"><AdminIcon name="paw" size={28} /></span>
          <div><strong>{brand}</strong><small>{en ? 'ADMINISTRATION' : 'BOARD GAME COLLECTION'}</small></div>
        </div>
        <nav class="shell-nav" aria-label={en ? 'Administration navigation' : '管理導覽'}>
          {adminNavigation.map(group => {
            const expanded = group.items.some(item => item.id === current);
            const panel = 'admin-nav-' + group.id;
            return (
              <div class:list={['shell-group', { 'shell-overview': group.id === 'overview' }]}>
                {'icon' in group && (
                  <button type="button" data-shell-group aria-controls={panel} aria-expanded={expanded}>
                    <AdminIcon name={group.icon} />
                    <span>{en ? group.en : group.zh}</span>
                    <AdminIcon name="chevron-down" size={16} />
                  </button>
                )}
                <ul id={panel} hidden={'icon' in group && !expanded}>
                  {group.items.map(item => (
                    <li>
                      <a href={adminNavigationHref(item, lang)} aria-current={current === item.id ? 'page' : undefined}>
                        <AdminIcon name={item.icon} size={18} />
                        {en ? item.en : item.zh}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </nav>
        <div class="shell-footer">
          <a href={en ? '/en/' : '/'}><AdminIcon name="external-link" size={16} />{en ? 'Public website' : '公開網站'}</a>
          <a href={languageHref} data-language-switch lang={alternateLang}>{en ? '繁體中文' : 'English'}</a>
        </div>
      </aside>
      <dialog id="admin-drawer" class="shell-drawer" data-shell-drawer aria-label={en ? 'Navigation' : '導覽'}>
        <button type="button" class="shell-close" data-shell-close autofocus
          aria-label={en ? 'Close navigation' : '關閉導覽'}><AdminIcon name="x" /></button>
      </dialog>
      <div class="shell-main" id={current === 'requirements' ? 'editor-content' : undefined}
        tabindex={current === 'requirements' ? -1 : undefined}>
        {current === 'overview' && <img class="shell-banner" src="/images/admin/banner-1600.webp"
          srcset="/images/admin/banner-800.webp 800w, /images/admin/banner-1600.webp 1600w"
          sizes="(min-width: 1440px) calc(100vw - 260px), (min-width: 1100px) calc(100vw - 240px), 100vw"
          width="1600" height="533" alt="" aria-hidden="true" />}
        <slot />
      </div>
    </div>
    <script>
      import '../lib/admin-navigation';
      import { connectAdminShell } from '../lib/admin-shell-controller';
      connectAdminShell();
    </script>
  </body>
</html>
