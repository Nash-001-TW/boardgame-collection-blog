---
import Layout from "../../src/layouts/Layout.astro";

import {
    getGames
} from "../../src/lib/games";


const games =
    getGames();
---


<Layout title="BGG Cache Test">

    <main>

        <h1>
            BGG JSON Cache 測試
        </h1>


        {
            games.map(game => (

                <article>

                    {
                        game.bgg?.image && (

                            <img
                                src={game.bgg.image}
                                alt={game.name}
                                width="200"
                            />

                        )
                    }


                    <h2>
                        {game.name}
                    </h2>


                    <p>
                        BGG ID：
                        {game.bggId}
                    </p>


                    <p>
                        年份：
                        {game.bgg?.year ?? "未提供"}
                    </p>


                    <p>
                        BGG Rating：
                        {
                            game.bgg?.averageRating
                                ?.toFixed(2) ?? "未提供"
                        }
                    </p>


                    <p>
                        BGG Rank：
                        {
                            game.bgg?.overallRank
                            ?? "未排名"
                        }
                    </p>


                </article>

            ))
        }

    </main>

</Layout>
