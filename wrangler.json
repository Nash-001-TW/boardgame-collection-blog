{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boardgame-collection-blog",
  "observability": {
    "enabled": true
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/games/*",
      "/en/games/*",
      "/*%*",
      "//*",
      "/en//*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boardgame-collection-db",
      "database_id": "59e9a17a-ff0f-494e-aab9-dd903a14e395",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "c8cacd003f7043f7a12368210f91e256"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "NOTBGG_WRITE_LIMITER",
      "namespace_id": "12071",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "main": "./src/worker.ts"
}
